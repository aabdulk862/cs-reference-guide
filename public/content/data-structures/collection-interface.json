              ],
              "rows": [
                [
                  "HashMap",
                  "Hash-based implementation, allows null keys and values."
                ],
                [
                  "LinkedHashMap",
                  "Maintains insertion order."
                ],
                [
                  "TreeMap",
                  "Sorted map based on keys."
                ],
                [
                  "Hashtable",
                  "Legacy synchronized map."
                ]
              ]
            }
