{
  "id": "spring-rest-definitions-examples",
  "slug": "definitions-examples",
  "title": "Definitions & Examples",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "why-do-we-need-actuators",
      "heading": "Why Do We Need Actuators?",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Control Panel: Acts as a dashboard to monitor and manage the application.",
            "Real-time Insights: Provides valuable data such as app health, metrics, environment configurations.",
            "Production-Ready: Crucial for maintaining application stability and debugging in live environments."
          ]
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "what-are-actuators-in-spring-boot",
      "heading": "What Are Actuators in Spring Boot?",
      "level": 3,
      "content": [
        {
          "type": "blockquote",
          "text": "Definition: Spring Boot Actuators are tools that expose endpoints to manage and monitor your application without adding extra code."
        }
      ],
      "wordCount": 19,
      "subsections": []
    },
    {
      "id": "features",
      "heading": "Features:",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Health checks",
            "Metrics (e.g., memory, CPU)",
            "Bean info",
            "Environment properties",
            "Custom endpoint support"
          ]
        }
      ],
      "wordCount": 13,
      "subsections": []
    },
    {
      "id": "benefits-of-using-actuators",
      "heading": "Benefits of Using Actuators",
      "level": 3,
      "content": [
        {
          "type": "table",
          "headers": [
            "Feature",
            "Description"
          ],
          "rows": [
            [
              "Observability",
              "Gives visibility into health, logs, metrics, etc."
            ],
            [
              "Diagnostics",
              "Endpoints like /health and /metrics help troubleshoot issues."
            ],
            [
              "Customization",
              "Enable/disable endpoints, configure security, or create custom endpoints."
            ],
            [
              "Integration",
              "Easily integrates with tools like Prometheus, Grafana, etc."
            ],
            [
              "Development & Testing",
              "Access runtime info via /env, /auditevents for simplified testing."
            ]
          ]
        }
      ],
      "wordCount": 49,
      "subsections": []
    },
    {
      "id": "basic-setup",
      "heading": "Basic Setup",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Add Dependency to pom.xml:"
          ]
        },
        {
          "type": "code",
          "language": "xml",
          "code": "<dependency>\n    <groupId>org.springframework.boot</groupId>\n    <artifactId>spring-boot-starter-actuator</artifactId>\n</dependency>",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Run Application"
          ]
        },
        {
          "type": "paragraph",
          "text": "This will enable default endpoints like:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "/actuator/health",
            "/actuator/metrics"
          ]
        }
      ],
      "wordCount": 14,
      "subsections": []
    },
    {
      "id": "exposing-endpoints",
      "heading": "Exposing Endpoints",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "application.properties"
        },
        {
          "type": "code",
          "language": "",
          "code": "management.endpoints.web.exposure.include=*\nmanagement.endpoints.enabled-by-default=true",
          "runnable": false
        },
        {
          "type": "blockquote",
          "text": "Exposes all available endpoints."
        },
        {
          "type": "paragraph",
          "text": "To expose specific endpoints:"
        },
        {
          "type": "code",
          "language": "",
          "code": "management.endpoints.web.exposure.include=health,info",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "To exclude specific endpoints:"
        },
        {
          "type": "code",
          "language": "",
          "code": "management.endpoints.web.exposure.exclude=shutdown",
          "runnable": false
        }
      ],
      "wordCount": 13,
      "subsections": []
    },
    {
      "id": "security-configurations",
      "heading": "Security Configurations",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Enable basic authentication:"
        },
        {
          "type": "code",
          "language": "",
          "code": "management.endpoints.web.security.basic.enabled=true",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Use Spring Security for finer control over roles and access."
        }
      ],
      "wordCount": 13,
      "subsections": []
    },
    {
      "id": "changing-management-port",
      "heading": "Changing Management Port",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Run actuator endpoints on a different port:"
        },
        {
          "type": "code",
          "language": "",
          "code": "management.server.port=9090",
          "runnable": false
        },
        {
          "type": "table",
          "headers": [
            "Endpoint",
            "Path",
            "Description"
          ],
          "rows": [
            [
              "Health",
              "/actuator/health",
              "Shows if the app is UP/DOWN. Useful for uptime monitoring."
            ],
            [
              "Metrics",
              "/actuator/metrics",
              "Provides metrics like memory, GC stats, thread usage, etc."
            ],
            [
              "Info",
              "/actuator/info",
              "Displays custom app metadata like version, description."
            ],
            [
              "Beans",
              "/actuator/beans",
              "Lists all Spring beans with dependencies."
            ],
            [
              "Env",
              "/actuator/env",
              "Shows environment properties."
            ],
            [
              "Audit Events",
              "/actuator/auditevents",
              "Tracks login/logout events."
            ],
            [
              "Caches",
              "/actuator/caches",
              "Displays cache statistics and status."
            ],
            [
              "Shutdown",
              "/actuator/shutdown",
              "Gracefully shuts down the app (must be enabled manually)."
            ],
            [
              "Main Actuator Dashboard",
              "/actuator",
              "Lists all active actuator endpoints."
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "You can define your own actuator endpoint:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "@Component\n@Endpoint(id = \"customstatus\")\npublic class CustomStatusEndpoint {\n\n    @ReadOperation\n    public String getStatus() {\n        return \"Application running smoothly!\";\n    }\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Access it at:"
        },
        {
          "type": "code",
          "language": "",
          "code": "/actuator/customstatus",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Metrics Endpoint: /actuator/metrics",
            "Can be integrated with tools like Prometheus, Grafana, New Relic, etc.",
            "Use it to monitor: "
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Endpoint: /actuator/health",
            "Shows app status: UP, DOWN, OUT_OF_SERVICE, etc.",
            "Custom Health Indicators can be added:"
          ]
        },
        {
          "type": "code",
          "language": "java",
          "code": "@Component\npublic class CustomHealthIndicator implements HealthIndicator {\n    @Override\n    public Health health() {\n        // Your health logic here\n        return Health.up().withDetail(\"service\", \"Running\").build();\n    }\n}",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Endpoint: /actuator/shutdown",
            "Must be explicitly enabled:"
          ]
        },
        {
          "type": "code",
          "language": "",
          "code": "management.endpoint.shutdown.enabled=true",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Ensure strict security as this can stop your app!"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Term",
            "Definition",
            "Example"
          ],
          "rows": [
            [
              "Actuator",
              "A Spring Boot tool for app monitoring/management",
              "/actuator/health"
            ],
            [
              "Endpoint",
              "A URL path that returns system info",
              "/actuator/metrics"
            ],
            [
              "Metric",
              "Data about system performance",
              "Memory usage, CPU load"
            ],
            [
              "Health Check",
              "Endpoint indicating system status",
              "UP, DOWN"
            ],
            [
              "Bean",
              "A Spring-managed object",
              "@Component, @Service annotated classes"
            ],
            [
              "Environment",
              "Properties and profiles in Spring",
              "application.properties, /env endpoint"
            ]
          ]
        }
      ],
      "wordCount": 201,
      "subsections": []
    },
    {
      "id": "security-considerations",
      "heading": "Security Considerations",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Authentication: Use basic auth or Spring Security.",
            "Authorization: Restrict roles to specific endpoints.",
            "Best Practice: Never expose sensitive actuator endpoints publicly."
          ]
        }
      ],
      "wordCount": 21,
      "subsections": []
    }
  ],
