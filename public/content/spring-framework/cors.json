  "title": "CORS",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "communication-between-ui-and-rest-apis",
      "heading": "Communication between UI and REST APIs",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "scenario-1-same-origin-requests",
          "heading": "Scenario 1: Same-Origin Requests",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "UI and REST API are part of the same application.",
                "These requests are allowed by default.",
                "No special configuration needed."
              ]
            }
          ],
          "wordCount": 20,
          "subsections": []
        },
        {
          "id": "scenario-2-cross-origin-requests",
          "heading": "Scenario 2: Cross-Origin Requests",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "UI and REST API are part of different applications.",
                "These requests are blocked by default due to browser security policies."
              ]
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Rest/CORS/CORS/image.png",
              "alt": "image.png",
              "originalPath": "CORS/image.png"
