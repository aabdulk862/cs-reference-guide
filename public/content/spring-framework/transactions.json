    {
      "id": "key-behavior",
      "heading": "Key Behavior",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Behavior",
            "Explanation"
          ],
          "rows": [
            [
              "One transaction per chunk",
              "Each chunk’s read-process-write cycle occurs inside one transaction"
            ],
            [
              "Processor/Writer exceptions → rollback",
              "Rollback entire chunk and retry"
            ],
            [
              "Reader exceptions → no rollback",
              "Reader exceptions do not cause rollback (because data may be corrupted)"
            ]
          ]
        }
      ],
      "wordCount": 39,
      "subsections": []
    },
    {
      "id": "example-java",
      "heading": "Example (Java)",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": ".stepBuilderFactory.get(\"step1\")\n    .<Input, Output>chunk(10)\n    .reader(reader())\n    .processor(processor())\n    .writer(writer())\n    .build();",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Each chunk of 10 items will run inside a single transaction."
        }
      ],
      "wordCount": 11,
      "subsections": [
        {
          "id": "example-timeline",
          "heading": "Example Timeline",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Chunk size = 10",
                "Items 1–10 processed in one transaction",
                "If writer fails → rollback whole chunk",
                "Then retry processing the same 10 items again"
              ]
            }
          ],
          "wordCount": 25,
          "subsections": []
        }
      ]
    },
    {
      "id": "avoiding-rollback",
      "heading": "Avoiding Rollback",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Sometimes you want the step to continue even if a specific exception is thrown, without rolling back the transaction."
        }
      ],
      "wordCount": 19,
      "subsections": []
    },
    {
      "id": "use-case-examples",
      "heading": "Use Case Examples",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Validation errors you want to treat as minor",
            "Logging or auditing failures",
            "Non-critical data issues"
          ]
        },
        {
          "type": "paragraph",
          "text": "You can configure this using:"
        }
      ],
      "wordCount": 20,
      "subsections": [
        {
          "id": "xml-example",
          "heading": "XML Example",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "xml",
              "code": "<tasklet>\n    <chunk reader=\"reader\" writer=\"writer\" commit-interval=\"100\" skip-limit=\"5\">\n\n        <no-rollback-exception-classes>\n            <include class=\"org.springframework.batch.item.validator.ValidatorException\"/>\n        </no-rollback-exception-classes>\n\n    </chunk>\n</tasklet>",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "java-example",
          "heading": "Java Example",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": ".faultTolerant()\n.noRollback(ValidatorException.class)",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "behavior",
      "heading": "Behavior",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "The step does not roll back when ValidatorException occurs.",
            "However, you may still skip or continue depending on skip/retry settings."
          ]
        }
