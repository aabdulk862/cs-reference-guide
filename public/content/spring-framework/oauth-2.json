        {
          "id": "access-secured-api-with-token",
          "heading": "Access Secured API with Token",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use the access token as a query param:"
            },
            {
              "type": "paragraph",
              "text": "Example:"
            },
            {
              "type": "code",
              "language": "",
              "code": "http://localhost:5454/FlightAPI/source?access_token=<your_token>",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Repeat for other endpoints:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "/destination",
                "/Chennai/Noida/30-09-2017"
              ]
            }
          ],
          "wordCount": 15,
          "subsections": []
        }
      ]
