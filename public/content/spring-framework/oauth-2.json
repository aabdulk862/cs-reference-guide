      "subsections": [
        {
          "id": "what-is-rest-api-security",
          "heading": "What is REST API Security?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "When exposing RESTful web services, it’s important to secure endpoints to prevent unauthorized access. One standard way to secure APIs is by using OAuth2 with Spring Security."
            }
          ],
          "wordCount": 27,
          "subsections": []
        },
        {
          "id": "what-is-spring-security",
          "heading": "What is Spring Security?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Spring Security is a powerful and customizable authentication and access-control framework. It’s the de facto standard for securing Spring-based applications."
            }
          ],
          "wordCount": 20,
          "subsections": []
        },
        {
          "id": "what-is-oauth2",
          "heading": "What is OAuth2?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "OAuth 2.0 is an authorization framework that allows third-party services to exchange web resources on behalf of a user."
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Access Token: A token that grants access to a protected resource.",
                "Client ID / Secret: Credentials identifying the client app.",
                "Authorization Server: Issues tokens.",
                "Resource Server: Hosts protected resources (REST APIs)."
              ]
            }
          ],
          "wordCount": 50,
          "subsections": []
        }
      ]
    },
