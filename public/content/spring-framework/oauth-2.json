    {
      "id": "behind-the-scenes-how-it-works",
      "heading": "Behind the Scenes – How It Works",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "authorization-server",
          "heading": "Authorization Server",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Enabled via @EnableAuthorizationServer",
                "Auto-generates /oauth/token and /oauth/authorize endpoints",
                "Uses properties like: "
              ]
            },
            {
              "type": "blockquote",
              "text": "These values are auto-generated by Spring Boot unless customized."
            },
            {
              "type": "paragraph",
              "text": "To override default behavior:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\npublic AuthorizationServerConfigurer authorizationServerConfigurer() {\n  // Define your own client-id/client-secret logic (e.g., from DB)\n}",
              "runnable": false
            }
          ],
          "wordCount": 24,
          "subsections": []
        },
        {
          "id": "resource-server",
          "heading": "Resource Server",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Enabled via @EnableResourceServer",
                "Protects your API endpoints",
                "Verifies access tokens before granting access"
              ]
            },
            {
              "type": "paragraph",
              "text": "Spring Boot automatically configures token validation when both annotations are present in the app."
            }
          ],
          "wordCount": 27,
          "subsections": []
        }
      ]
    },
    {
      "id": "important-notes",
      "heading": "Important Notes",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Spring Security + OAuth2 automatically secure your APIs",
            "Every time you restart the app, a new client-id and client-secret are generated",
            "Postman is used here for testing, but any OAuth2-compatible client (like frontend apps) can use the access token"
          ]
        }
      ],
      "wordCount": 39,
      "subsections": []
    },
