        {
          "id": "create-main-class",
          "heading": "Create Main Class",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "InfyGoBootOAuthSecurityApplication.java"
            },
            {
              "type": "code",
              "language": "java",
              "code": "package com.infosys.irs;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\nimport org.springframework.security.oauth2.config.annotation.web.configuration.EnableAuthorizationServer;\nimport org.springframework.security.oauth2.config.annotation.web.configuration.EnableResourceServer;\n\n@SpringBootApplication\n@EnableAuthorizationServer      // Enables OAuth2 authorization endpoints\n@EnableResourceServer           // Enables protection of REST resources\npublic class InfyGoBootOAuthSecurityApplication {\n  public static void main(String[] args) {\n    SpringApplication.run(InfyGoBootOAuthSecurityApplication.class, args);\n  }\n}",
              "runnable": false
            }
          ],
