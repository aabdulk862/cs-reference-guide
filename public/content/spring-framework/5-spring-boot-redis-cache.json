      "id": "configuration-steps",
      "heading": "Configuration Steps",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Add Dependency (in pom.xml or build.gradle): <dependency>\n    <groupId>org.springframework.boot</groupId>\n    <artifactId>spring-boot-starter-data-redis</artifactId>\n</dependency>",
            "application.properties: spring.cache.type=redis\nspring.redis.host=localhost\nspring.redis.port=6379"
          ]
        }
      ],
      "wordCount": 14,
      "subsections": []
    },
    {
      "id": "enabling-caching",
      "heading": "Enabling Caching",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Annotation-based configuration:  Example: @Cacheable(\"users\")\npublic User getUserById(String id) {\n    // expensive call like DB fetch\n    return userRepository.findById(id).orElse(null);\n}"
          ]
        }
      ],
      "wordCount": 18,
      "subsections": []
    },
    {
      "id": "benefits-of-redis-caching",
      "heading": "Benefits of Redis Caching",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Fast access due to in-memory data structure.",
            "Reduces DB load and improves application response time.",
            "Supports TTL (Time To Live) for automatic cache eviction."
          ]
