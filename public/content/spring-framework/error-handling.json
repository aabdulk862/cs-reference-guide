{
  "id": "spring-batch-error-handling",
  "slug": "error-handling",
  "title": "Error Handling",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Spring Batch provides powerful mechanisms to handle failures gracefully during batch processing."
        },
        {
          "type": "paragraph",
          "text": "The main strategies are:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Skip → Ignore faulty items (non-fatal errors)",
            "Retry → Retry transient failures",
            "Restart → Continue a failed job from the point of failure"
          ]
        }
      ],
      "wordCount": 39,
      "subsections": []
    },
    {
      "id": "skip",
      "heading": "Skip",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "what-is-skip",
      "heading": "What is Skip?",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Skip is used when an individual item encounters a non-fatal exception but the batch should continue processing the rest."
        },
        {
          "type": "paragraph",
          "text": "Used when:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "The corrupted/invalid data can be ignored",
            "You want the step to continue despite errors"
          ]
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "key-properties",
      "heading": "Key Properties",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Property",
            "Purpose"
          ],
          "rows": [
            [
              "skippable-exception-classes",
              "Exceptions that can be skipped"
            ],
            [
              "skip-limit",
              "Maximum number of skips allowed before failing"
            ]
          ]
        }
      ],
      "wordCount": 16,
      "subsections": []
    },
    {
      "id": "xml-example",
      "heading": "XML Example",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "xml",
          "code": "<tasklet>\n    <chunk reader=\"reader\" writer=\"writer\" commit-interval=\"100\" skip-limit=\"10\">\n        <skippable-exception-classes>\n            <include class=\"org.springframework.batch.item.file.FlatFileParseException\"/>\n        </skippable-exception-classes>\n    </chunk>\n</tasklet>",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": [
        {
          "id": "java-config-example",
          "heading": "Java Config Example",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": ".stepBuilderFactory.get(\"fileStep\")\n    .<Input, Output>chunk(100)\n    .reader(reader())\n    .writer(writer())\n    .faultTolerant()\n    .skip(FlatFileParseException.class)\n    .skipLimit(10)\n    .build();",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
