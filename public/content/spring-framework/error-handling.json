    {
      "id": "3-via-a-step-listener-in-chunk-execution",
      "heading": "3. Via a Step Listener (in chunk execution)",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "listener-example",
          "heading": "Listener Example",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Component\npublic class StopListener {\n\n    private StepExecution stepExecution;\n\n    @BeforeStep\n    public void beforeStep(StepExecution stepExecution) {\n        this.stepExecution = stepExecution;\n    }\n\n    @AfterStep\n    public void afterStep() {\n        stepExecution.setTerminateOnly(); // signal job to stop\n    }\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "register-listener",
