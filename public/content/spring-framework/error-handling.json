              "Reattempt temporary failures",
              "DB deadlock, network issue"
            ],
            [
              "Retry + Skip",
              "Retry first, skip later",
              "Persistent transient failure"
            ],
            [
              "Restart",
              "Resume after job failure",
              "Resume large file processing"
            ],
            [
