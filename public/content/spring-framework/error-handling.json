              "type": "code",
              "language": "xml",
              "code": "<batch:chunk reader=\"reader\" writer=\"writer\" commit-interval=\"100\"/>\n<batch:listeners>\n    <batch:listener ref=\"stopListener\"/>\n</batch:listeners>\n",
              "runnable": false
