  "title": "Best Practices for RESTful APIs",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "goals-of-a-restful-application",
      "heading": "Goals of a RESTful Application",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Expose resources via unique URIs",
            "Support multiple representations (JSON/XML)",
            "Use standard HTTP methods (GET, POST, PUT, DELETE, etc.)",
            "Ensure stateless communication",
            "Support discoverability using HATEOAS",
            "Handle validation and exceptions properly",
            "Secure endpoints appropriately"
          ]
        }
      ],
      "wordCount": 33,
      "subsections": []
    },
    {
      "id": "1-jax-rs-java-api-for-restful-web-services",
      "heading": "1. JAX-RS (Java API for RESTful Web Services)",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Specification, not an implementation.",
            "Requires implementation like: "
          ]
        }
      ],
      "wordCount": 7,
      "subsections": [
        {
          "id": "features",
          "heading": "Features:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Uses annotations to define endpoints",
                "Supports JSON/XML out of the box",
                "Example: @Path(\"/customers\")\npublic class CustomerService {\n    @GET\n    @Produces(MediaType.APPLICATION_JSON)\n    public List<Customer> getCustomers() {\n        // ...\n    }\n}\n"
              ]
            }
          ],
          "wordCount": 27,
          "subsections": []
        }
      ]
    },
    {
      "id": "2-spring-rest-via-spring-mvc",
      "heading": "2. Spring REST (via Spring MVC)",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Part of the Spring Framework",
            "Built on Spring MVC module",
            "Extended using Spring Boot for minimal configuration",
            "Not based on JAX-RS, it is an independent approach"
          ]
        },
