          "id": "spring-rest-annotations",
          "heading": "Spring REST Annotations:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "@RestController: Combines @Controller and @ResponseBody",
                "@RequestMapping: Maps URI paths and HTTP methods",
                "@GetMapping, @PostMapping, @PutMapping, @DeleteMapping, @PatchMapping: Shorthand annotations"
              ]
            }
          ],
          "wordCount": 19,
          "subsections": []
        },
