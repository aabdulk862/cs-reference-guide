        {
          "id": "spring-dispatcherservlet-internals",
          "heading": "Spring DispatcherServlet Internals",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Client sends request to the server",
                "DispatcherServlet receives and delegates to appropriate controller",
                "Controller processes request and returns response",
                "DispatcherServlet sends response to client"
              ]
            },
            {
              "type": "blockquote",
              "text": "🔍 Unlike Spring MVC, REST does not use view resolvers, as it sends data (JSON/XML) not views (HTML)."
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use appropriate HTTP verbs",
                "Use plural nouns for resource names (/customers)",
                "Use status codes properly (200 OK, 201 Created, 400 Bad Request, etc.)",
                "Provide consistent URI structure",
                "Enable HATEOAS for discoverability",
                "Secure APIs using OAuth, JWT, etc.",
                "Validate inputs and handle exceptions gracefully"
              ]
            }
          ],
          "wordCount": 85,
          "subsections": []
        }
