        {
          "id": "levels-of-rmm",
          "heading": "Levels of RMM:",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Level",
                "Characteristics"
              ],
              "rows": [
                [
                  "0",
                  "Single URI and HTTP method (typically POST); resembles SOAP/XML-RPC"
                ],
                [
                  "1",
                  "Multiple URIs for resources but still uses single HTTP method (POST)"
                ],
                [
                  "2",
                  "Multiple URIs + appropriate HTTP methods (GET, POST, PUT, DELETE)"
                ],
                [
                  "3",
                  "Adds HATEOAS for discoverability in response"
                ]
              ]
            }
          ],
          "wordCount": 42,
          "subsections": []
        },
