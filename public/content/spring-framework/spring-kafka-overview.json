      "id": "infyrail-sender-application-kafka-producer",
      "heading": "InfyRail Sender Application (Kafka Producer)",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "highlights",
          "heading": "Highlights",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "A Spring Boot application using spring-kafka dependency.",
                "pom.xml includes: <dependency>\n  <groupId>org.springframework.kafka</groupId>\n  <artifactId>spring-kafka</artifactId>\n</dependency>",
                "No custom configuration needed in application.properties.",
                "Topic Creation: @Bean\npublic NewTopic topic() {\n  return TopicBuilder.name(\"InfyRail_CityA_To_CityB\").partitions(1).replicas(1).build();\n}",
                "Message Sending: @Bean\npublic ApplicationRunner sendMessage(KafkaTemplate<String, String> template) {\n  return args -> {\n    for(int i=0; i<500; i++) {\n      template.send(\"InfyRail_CityA_To_CityB\", \" Current Speed of Train is: \" + Math.round(Math.random() * 100) + \" Kmph.\");\n      System.out.println(\"Speed information sent successfully for \" + (i + 1) + \" of 500 times\");\n      Thread.sleep(3000);\n    }\n  };\n}"
              ]
            }
          ],
          "wordCount": 81,
          "subsections": []
        },
        {
          "id": "project-details",
          "heading": "Project Details",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Artifact: infyrail_sender",
                "Java Version: 17",
                "Kafka Port: 9092 (default)",
                "Loop: Sends messages 500 times with a 3-second interval."
              ]
            }
          ],
          "wordCount": 18,
