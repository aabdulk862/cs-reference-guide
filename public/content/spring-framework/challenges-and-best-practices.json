        },
        {
          "id": "asynchronous-communication",
          "heading": "Asynchronous Communication",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Uses messaging systems like Kafka or RabbitMQ.",
                "Reduces latency and improves resilience."
