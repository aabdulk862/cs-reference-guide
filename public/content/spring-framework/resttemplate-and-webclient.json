    {
      "id": "spring-rest-client-resttemplate",
      "heading": "Spring REST Client: RestTemplate",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "definition",
          "heading": "Definition",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "RestTemplate is a synchronous REST client in Spring for making HTTP requests."
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Package: org.springframework.web.client.RestTemplate",
                "Suitable for simple and traditional REST calls."
              ]
            }
          ],
          "wordCount": 21,
          "subsections": []
        },
        {
          "id": "instantiating-resttemplate",
          "heading": "Instantiating RestTemplate",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\npublic RestTemplate restTemplate() {\n    return new RestTemplate();\n}",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "💡 Register as a singleton bean and inject via @Autowired."
            }
          ],
          "wordCount": 10,
          "subsections": []
        }
      ]
    },
    {
      "id": "resttemplate-methods",
      "heading": "RestTemplate Methods",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Method",
            "HTTP Verb",
            "Description"
          ],
          "rows": [
            [
              "getForObject(url, Class<T>)",
              "GET",
              "Returns response body directly."
            ],
            [
              "getForEntity(url, Class<T>)",
              "GET",
              "Returns ResponseEntity (includes status, headers, body)."
            ],
            [
              "postForObject(url, request, Class<T>)",
              "POST",
              "Posts and returns response body."
            ],
            [
              "postForEntity(url, request, Class<T>)",
              "POST",
              "Posts and returns ResponseEntity."
            ],
            [
              "put(url, request, ...)",
              "PUT",
              "Sends PUT request. No return."
            ],
            [
              "delete(url)",
              "DELETE",
              "Sends DELETE request."
            ],
            [
              "exchange(url, method, HttpEntity, Class<T>)",
              "ANY",
              "General-purpose method for full control."
            ]
          ]
        }
      ],
