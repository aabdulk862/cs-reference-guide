          ]
        }
      ],
      "wordCount": 89,
      "subsections": [
        {
          "id": "usage-example-blocking",
          "heading": "Usage Example (Blocking)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "WebClient.Builder builder = WebClient.builder();\nPlanDTO plan = builder.build()\n    .get()\n    .uri(\"http://localhost:8080/plans/1\")\n    .retrieve()\n    .bodyToMono(PlanDTO.class)\n    .block();  // Blocks the thread (like RestTemplate)\n",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "usage-example-non-blocking",
          "heading": "Usage Example (Non-blocking)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "webClient.get()\n    .uri(\"http://localhost:8080/plans/1\")\n    .retrieve()\n    .bodyToMono(PlanDTO.class)\n    .subscribe(data -> {\n        // Async processing\n        System.out.println(data);\n    });",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "resttemplate-vs-webclient",
      "heading": "RestTemplate vs WebClient",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Feature",
            "RestTemplate",
            "WebClient"
