          "type": "table",
          "headers": [
            "Use Case",
            "Recommended Client"
          ],
          "rows": [
            [
              "Simple REST calls",
              "RestTemplate (legacy)"
            ],
            [
              "High concurrency",
              "WebClient"
            ],
            [
              "Streaming data",
              "WebClient"
            ],
            [
