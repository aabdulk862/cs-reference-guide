    {
      "id": "modern-rest-client-webclient-spring-webflux",
      "heading": "Modern REST Client: WebClient (Spring WebFlux)",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "definition",
          "heading": "Definition",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "WebClient is a non-blocking, asynchronous, and reactive HTTP client introduced in Spring 5."
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Part of spring-webflux module",
                "Uses Project Reactor (Mono, Flux)",
                "Replaces RestTemplate for modern applications"
              ]
            }
          ],
          "wordCount": 27,
          "subsections": []
        },
        {
          "id": "dependency",
          "heading": "Dependency",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "xml",
              "code": "<dependency>\n  <groupId>org.springframework.boot</groupId>\n  <artifactId>spring-boot-starter-webflux</artifactId>\n</dependency>",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "key-components",
          "heading": "Key Components",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "WebClient.builder() – for creating reusable clients.",
                "Mono<T> – represents 0 or 1 response item.",
                "Flux<T> – represents 0 or more response items (a stream)."
              ]
            }
          ],
          "wordCount": 24,
          "subsections": []
        }
      ]
    },
