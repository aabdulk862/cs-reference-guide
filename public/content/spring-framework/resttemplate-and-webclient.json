{
  "id": "spring-rest-resttemplate-and-webclient",
  "slug": "resttemplate-and-webclient",
  "title": "RestTemplate and WebClient",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Spring provides support for building applications that expose REST services and consume services from other APIs, even if those are built using different languages or platforms (e.g., .NET, Node.js, Python)."
        },
        {
          "type": "paragraph",
          "text": "Examples of REST API consumers:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Java Applications",
            ".NET Applications",
            "Angular/React Frontends",
            "API Testing Tools (e.g., Postman)"
          ]
        }
      ],
      "wordCount": 46,
      "subsections": []
    },
    {
      "id": "traditional-java-rest-client",
      "heading": "Traditional Java REST Client",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "built-in-java-support",
          "heading": "Built-in Java Support",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Java SE provides basic REST client functionality via java.net.URL. This is considered low-level and boilerplate-heavy."
            },
            {
              "type": "code",
              "language": "java",
              "code": "URL url = new URL(\"http://example.com/api\");\nHttpURLConnection conn = (HttpURLConnection) url.openConnection();\nconn.setRequestMethod(\"GET\");",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "⚠️ Requires manual handling of HTTP methods, headers, input/output streams."
            }
          ],
          "wordCount": 25,
          "subsections": []
        }
      ]
    },
