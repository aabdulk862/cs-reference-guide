    {
      "id": "summary",
      "heading": "Summary",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "RestTemplate is a simple, blocking REST client, suitable for legacy applications.",
            "WebClient is a modern, reactive, non-blocking REST client, suitable for scalable, high-performance systems.",
            "Best practice is to prefer WebClient for new development, especially with Spring WebFlux."
          ]
        }
      ],
      "wordCount": 37,
      "subsections": []
    },
    {
      "id": "definitions",
      "heading": "Definitions",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Blocking I/O: The thread waits for the response before continuing.",
            "Non-blocking I/O: The thread sends the request and continues other work; response is handled asynchronously.",
            "Mono: A publisher that emits 0 or 1 items.",
            "Flux: A publisher that emits 0 to many items.",
            "Reactive Programming: A programming paradigm focused on asynchronous data streams."
          ]
        }
      ],
      "wordCount": 53,
      "subsections": []
