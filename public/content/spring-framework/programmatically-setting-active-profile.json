          "type": "list",
          "ordered": false,
          "items": [
            "Use the naming convention: application-<environment>.properties "
          ]
        }
      ],
      "wordCount": 5,
      "subsections": []
    },
    {
      "id": "setting-active-profile",
      "heading": "Setting Active Profile",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "In application.properties:"
        },
        {
          "type": "code",
          "language": "",
          "code": "spring.profiles.active=dev",
          "runnable": false
        }
      ],
      "wordCount": 2,
      "subsections": []
    },
    {
      "id": "using-springapplicationsetadditionalprofiles",
      "heading": "Using SpringApplication.setAdditionalProfiles()",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": "SpringApplication app = new SpringApplication(MyApp.class);\napp.setAdditionalProfiles(\"dev\");\napp.run(args);",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "using-configurableenvironment",
      "heading": "Using ConfigurableEnvironment",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": "ConfigurableApplicationContext ctx = SpringApplication.run(MyApp.class, args);\nConfigurableEnvironment env = ctx.getEnvironment();\nenv.setActiveProfiles(\"dev\");",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "using-profile-annotation",
      "heading": "Using @Profile Annotation",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": "@Profile(\"dev\")\n@Component\npublic class DevDataSourceConfig {\n    // Configuration specific to development\n}",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "The component is loaded only when the active profile is \"dev\"."
          ]
        }
      ],
