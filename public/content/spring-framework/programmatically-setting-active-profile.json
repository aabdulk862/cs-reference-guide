    {
      "id": "5-run-application-in-development-mode",
      "heading": "5. Run Application in Development Mode",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Ensure spring.profiles.active=dev is set.",
            "Start application.",
            "Open Signup page and verify DB operations using MySQL."
          ]
        }
      ],
      "wordCount": 15,
      "subsections": []
    },
    {
      "id": "6-switch-to-testing-mode",
      "heading": "6. Switch to Testing Mode",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Change in application.properties: spring.profiles.active=test",
            "Run application again.",
            "Observe HSQL in-memory database being used."
          ]
        }
