{
  "id": "spring-boot-programmatically-setting-active-profile",
  "slug": "programmatically-setting-active-profile",
  "title": "Programmatically Setting Active Profile",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "purpose-of-spring-profiles",
      "heading": "Purpose of Spring Profiles",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "Spring Boot Profiles help in managing different configurations for various environments such as:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Development",
            "Testing",
            "Production"
          ]
        },
        {
          "type": "paragraph",
          "text": "Instead of manually updating the application.properties file each time, Spring Profiles enable automatic selection of environment-specific properties."
        },
        {
          "type": "table",
          "headers": [
            "Environment",
            "Database",
            "Logging"
          ],
          "rows": [
            [
              "Development",
              "MySQL",
              "ErrorLog.log"
            ],
            [
              "Testing",
              "In-memory (HSQL)",
              "Console"
            ],
            [
              "Production",
              "Oracle",
              "ErrorLog_Prod.log"
            ]
          ]
        }
      ],
      "wordCount": 46,
      "subsections": []
    },
    {
      "id": "1-project-setup",
      "heading": "1. Project Setup",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Open Spring Tool Suite (STS)",
            "Import project: InfyGoBoot_UnitTesting",
            "Rename to: InfyGoBoot_Profiles"
          ]
        }
      ],
      "wordCount": 11,
      "subsections": []
    },
    {
      "id": "2-configure-applicationproperties-default",
      "heading": "2. Configure application.properties (default)",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "",
          "code": "# View resolver configuration\nspring.mvc.view.prefix = /WEB-INF/pages/\nspring.mvc.view.suffix = .jsp\n\n# Server configuration\nserver.servlet.context-path=/InfyGoBoot\nserver.port=4343\n\n# Logging configuration\nlogging.file=Errorlog.log\nlogging.level.root=WARN\nlogging.level.com.infosys.ars=ERROR\nlogging.pattern.file=%d{yyyy-MM-dd HH:mm:ss,SSS} %5p [%t] %c [%M] - %m%n\n\n# Activate development profile\nspring.profiles.active=dev",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": []
    },
    {
