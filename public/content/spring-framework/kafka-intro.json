  "title": "Kafka Intro",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Modern users demand real-time, interactive, and informative applications.",
            "Traditional database-centric systems only store and serve static state data (e.g., latest status, without context).",
            "These systems are limited in: ",
            "To overcome this, applications are moving towards event-driven architectures.",
            "Apache Kafka is a leading platform for building such systems using event streams and logs."
          ]
        }
      ],
      "wordCount": 52,
      "subsections": []
    },
    {
      "id": "infyrail-application",
      "heading": "InfyRail Application",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "use-case-scenario",
          "heading": "Use Case Scenario",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Train: A2B Express",
                "Route: City A → IRS1 → IRS2 → IRS3 → City B",
                "Passenger: Alice (on the train)",
                "Observer: Bob (waiting in City B, checking InfyRail)"
              ]
            }
          ],
          "wordCount": 28,
          "subsections": []
        }
      ]
    },
    {
      "id": "case-1-traditional-database-centric",
      "heading": "Case 1: Traditional Database-Centric",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-bob-sees",
          "heading": "What Bob Sees:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Departure time from City A",
                "Arrival/Departure times at intermediate stations IRS1–IRS3",
                "Arrival time at City B"
              ]
            }
          ],
          "wordCount": 16,
          "subsections": []
        },
        {
          "id": "limitations",
          "heading": "Limitations:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Data limited to what is stored as state in the database.",
                "No real-time updates or contextual insights.",
                "No way to know current speed, passenger count, temperature, etc."
              ]
            }
          ],
          "wordCount": 27,
          "subsections": []
        }
      ]
    },
    {
      "id": "case-2-messaging-system-centric-event-driven",
      "heading": "Case 2: Messaging System-Centric (Event-Driven)",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-bob-can-access",
          "heading": "What Bob Can Access:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Real-time arrival/departure updates at each station.",
                "Current speed of the train.",
                "Inside and outside temperature.",
                "Passenger count.",
                "How many will get off at the next station.",
                "Historical data: trends over week/month/year.",
                "Other rich telemetry and analytics."
              ]
            }
          ],
          "wordCount": 36,
          "subsections": []
        },
        {
          "id": "advantages",
          "heading": "Advantages:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Offers rich, dynamic, and real-time information.",
                "Data is streamed continuously from event sources (sensors, subsystems).",
                "Uses logs/events instead of static records."
              ]
            }
          ],
          "wordCount": 21,
          "subsections": []
        }
      ]
    },
    {
      "id": "key-concepts",
      "heading": "Key Concepts",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "state",
          "heading": "STATE",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: Current status of an entity.",
                "Example: Current train position, cash balance, A/C temperature.",
                "Stored in: Traditional databases.",
                "Use: Only provides snapshot data; lacks context or history."
              ]
            }
          ],
          "wordCount": 27,
          "subsections": []
        },
        {
          "id": "event",
          "heading": "EVENT",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: An occurrence at a specific point in time.",
                "Includes: ",
                "Example: ",
                "Stored in: Logs"
              ]
            }
          ],
          "wordCount": 14,
          "subsections": []
        },
        {
          "id": "logs",
          "heading": "LOGS",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Ordered sequence of events",
                "Can be scaled and stored durably",
                "Foundation for building event-driven systems"
              ]
            }
          ],
          "wordCount": 15,
          "subsections": []
        },
        {
          "id": "topics",
          "heading": "TOPICS",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Durable logs stored and replicated across nodes",
                "Topic = Logical group of similar events (e.g., train-status-topic)",
                "Data stored for configurable retention periods"
              ]
            }
          ],
          "wordCount": 22,
          "subsections": []
        }
      ]
    },
