    {
      "id": "methods-of-passing-parameters",
      "heading": "Methods of passing parameters",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Command line"
        },
        {
          "type": "code",
          "language": "",
          "code": "java -jar batch.jar file=input.csv date=20240110",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "JobParametersBuilder"
        },
        {
          "type": "code",
