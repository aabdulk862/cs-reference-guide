    {
      "id": "config-example",
      "heading": "Config Example",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Steps:"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Add @EnableBatchProcessing",
            "Define a Job",
            "Define a Step",
            "Use a Tasklet inside the step"
          ]
        },
        {
          "type": "code",
          "language": "java",
          "code": "@EnableBatchProcessing\n@Configuration\npublic class BatchConfig {\n\n    @Bean\n    public Job firstJob(JobBuilderFactory jobBuilders, Step firstStep) {\n        return jobBuilders.get(\"firstJob\")\n            .start(firstStep)\n            .build();\n    }\n\n    @Bean\n    public Step firstStep(StepBuilderFactory stepBuilders, Tasklet tasklet) {\n        return stepBuilders.get(\"firstStep\")\n            .tasklet(tasklet)\n            .build();\n    }\n}",
          "runnable": false
        }
      ],
      "wordCount": 15,
      "subsections": []
