              "type": "code",
              "language": "java",
              "code": "public class CleanupTasklet implements Tasklet {\n    @Override\n    public RepeatStatus execute(StepContribution contribution, ChunkContext context) {\n        Files.deleteIfExists(Paths.get(\"/temp/input.csv\"));\n        return RepeatStatus.FINISHED;\n    }\n}",
              "runnable": false
