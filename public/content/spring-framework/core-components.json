{
  "id": "core-components-core-components",
  "slug": "core-components",
  "title": "Core Components",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Spring Batch applications are typically triggered by an external event (like a scheduler or REST endpoint), which launches a Job.",
            "The job interacts with data sources such as databases, file systems, or queues, and stores execution metadata in the Job Repository."
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Batch/Core Components/Core%20Components/image.png",
          "alt": "image.png",
          "originalPath": "Core%20Components/image.png"
        }
      ],
      "wordCount": 41,
      "subsections": []
    },
    {
      "id": "core-components-their-roles",
      "heading": "Core Components & Their Roles",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Component",
            "Description"
          ],
          "rows": [
            [
              "Job Repository",
              "Stores metadata about job/step executions (in DB)."
            ],
            [
              "Job Launcher",
              "Starts a Job with parameters."
            ],
            [
              "Job",
              "A full batch process, consisting of one or more steps."
            ],
            [
              "Step",
              "A phase in a job (Tasklet-based or Chunk-based)."
            ],
            [
              "Tasklet",
              "Repeatable unit of work inside a step."
            ],
            [
              "Item",
              "A single data unit (read or written)."
            ],
            [
              "Chunk",
              "A list of items processed together."
            ],
            [
              "ItemReader",
              "Reads input data one item at a time."
            ],
            [
              "ItemProcessor",
              "Processes/transforms/filter items."
            ],
            [
              "ItemWriter",
              "Writes a chunk of items."
            ]
          ]
        }
      ],
      "wordCount": 79,
      "subsections": []
    },
    {
      "id": "job",
      "heading": "Job",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "A Job is the complete batch process."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Batch/Core Components/Core%20Components/image%201.png",
          "alt": "image.png",
          "originalPath": "Core%20Components/image%201.png"
        }
      ],
      "wordCount": 7,
      "subsections": [
        {
          "id": "characteristics",
          "heading": "Characteristics",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Runs from start → end without interruption.",
                "Defined using Java config or XML config.",
                "Contains one or more steps.",
                "Can be executed repeatedly."
              ]
            }
          ],
          "wordCount": 23,
          "subsections": []
        },
        {
          "id": "common-example-of-a-job",
          "heading": "Common Example of a Job",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Import new products from a CSV file",
                "Validate and transform them",
                "Write them into a database"
              ]
            }
          ],
          "wordCount": 16,
          "subsections": []
        },
        {
          "id": "job-attributes",
          "heading": "Job Attributes",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Attribute",
                "Description"
              ],
              "rows": [
                [
                  "id",
                  "Job identifier."
                ],
                [
                  "restartable",
                  "Whether the job can be restarted after failure (true by default)."
                ],
                [
                  "job-repository",
                  "Job repository reference storing metadata."
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Example:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\npublic Job importJob(JobRepository jobRepository, Step step1) {\n    return jobBuilderFactory.get(\"importProductsJob\")\n        .repository(jobRepository)\n        .start(step1)\n        .build();\n}",
              "runnable": false
            }
          ],
          "wordCount": 24,
          "subsections": []
        }
      ]
    },
