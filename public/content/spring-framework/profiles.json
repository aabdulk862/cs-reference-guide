              "code": "-Dspring.profiles.active=dev",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "programmatic-activation",
          "heading": "Programmatic Activation",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "public static void main(String[] args) {\n    System.setProperty(AbstractEnvironment.ACTIVE_PROFILES_PROPERTY_NAME, \"prod\");\n    SpringApplication.run(MyApplication.class, args);\n}",
