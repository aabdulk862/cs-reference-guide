    {
      "id": "maven-profile-based-activation",
      "heading": "Maven Profile-Based Activation",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "1-add-profiles-to-pomxml",
          "heading": "1: Add Profiles to pom.xml",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "xml",
              "code": "<profiles>\n  <profile>\n    <id>dev</id>\n    <properties>\n      <spring.profiles.active>dev</spring.profiles.active>\n    </properties>\n  </profile>\n  <profile>\n    <id>test</id>\n    <activation>\n      <activeByDefault>true</activeByDefault>\n    </activation>\n    <properties>\n      <spring.profiles.active>test</spring.profiles.active>\n    </properties>\n  </profile>\n</profiles>",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "2-update-applicationproperties",
          "heading": "2: Update application.properties",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "spring.profiles.active=@spring.profiles.active@",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
