      "id": "key-code-components",
      "heading": "Key Code Components",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "sender-application-eventstreamsenderapplicationjava",
          "heading": "Sender Application (EventStreamSenderApplication.java)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\npublic ApplicationRunner sendMessage(KafkaTemplate<String, String> template) {\n    return args -> {\n        while(true) {\n            String speed = String.valueOf(Math.round(Math.random() * 1000));\n            String brkdata = String.valueOf(Math.round(Math.random() * 100));\n            template.send(\"InfyRail_C_To_D\", \"Speed\", speed);\n            template.send(\"InfyRail_C_To_D\", \"BrakeEfficiency\", brkdata);\n            System.out.println(\"Sending speed = \" + speed + \" Kmph and Brake efficiency = \" + brkdata + \" %.\");\n            Thread.sleep(2000);\n        }\n    };\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "receiver-filter-logic-filterdatajava",
          "heading": "Receiver Filter Logic (FilterData.java)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Autowired\npublic void setStreamBuilder(StreamsBuilder streamsBuilder) {\n    KStream<String, String> trainData = streamsBuilder.stream(\n        \"InfyRail_C_To_D\", Consumed.with(Serdes.String(), Serdes.String()));\n\n    trainData\n        .filter((key, value) -> key.equalsIgnoreCase(\"BrakeEfficiency\"))\n        .filter((key, value) -> Long.parseLong(value) < 70)\n        .to(\"InfyRail_C_To_D_Brake_Warning\", Produced.with(Serdes.String(), Serdes.String()));\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "receiver-listener-eventstreamreceiverapplicationjava",
          "heading": "Receiver Listener (EventStreamReceiverApplication.java)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@KafkaListener(id = \"IRC2D_1\", topics = \"InfyRail_C_To_D_Brake_Warning\")\npublic void listenToTopic2(ConsumerRecord<String, Long> message) {\n    System.out.println(\"Receiving \" + message.key() + \" as \" + message.value() + \" %.\");\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
