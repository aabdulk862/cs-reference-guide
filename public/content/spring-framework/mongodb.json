    {
      "id": "business-logic-layer-registrationservicejava",
      "heading": "Business Logic Layer: RegistrationService.java",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Handles:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Registration",
            "Validation",
            "Duplicate user checks"
          ]
        },
        {
          "type": "code",
          "language": "java",
          "code": "@Service\npublic class RegistrationService {\n    @Autowired\n    private UserRepository userRepository;\n\n    public String registerUser(User user) throws InfyGoBootException {\n        validateUser(user);\n        if (userRepository.findByUserId(user.getUserId()) != null)\n            throw new InfyGoBootException(\"RegistrationService.USERID_PRESENT\");\n\n        UserDocument doc = new UserDocument();\n        // Set fields from `user`\n        userRepository.insert(doc);\n        return \"UserRespository.REGISTRATION_SUCCESS\";\n    }\n\n    public void validateUser(User user) throws InfyGoBootException {\n        // Call methods like isValidUserId(), isValidEmail()...\n    }\n\n    public Boolean isValidEmail(String email) {\n        return Pattern.matches(\"^[A-Za-z0-9+_.-]+@(.+)$\", email);\n    }\n    // Other validators: userId, password, city, phone...\n}",
          "runnable": false
        }
      ],
      "wordCount": 6,
      "subsections": []
    },
