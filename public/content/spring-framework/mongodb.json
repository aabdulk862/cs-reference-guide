  "title": "MongoDB",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Spring Boot not only supports traditional SQL databases (e.g., MySQL) using Spring Data JPA, but also provides first-class support for NoSQL databases, such as MongoDB, via Spring Data MongoDB."
        },
        {
          "type": "paragraph",
          "text": "This guide explains how to:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Create a Spring Boot application with MongoDB integration.",
            "Connect to a MongoDB database.",
            "Perform operations like inserting a document into a collection using Spring Data MongoDB."
          ]
        }
      ],
      "wordCount": 60,
      "subsections": []
    },
    {
      "id": "definitions",
      "heading": "Definitions",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "mongodb",
          "heading": "MongoDB",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A NoSQL document-based database that stores data in JSON-like documents (BSON), offering flexibility and scalability for modern applications."
            }
          ],
          "wordCount": 18,
          "subsections": []
        },
        {
          "id": "collection",
          "heading": "Collection",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Equivalent to a table in RDBMS. A collection stores multiple documents."
            }
          ],
          "wordCount": 11,
          "subsections": []
        },
        {
          "id": "document",
          "heading": "Document",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A record in MongoDB, similar to a row in RDBMS. Stored in JSON/BSON format."
            }
          ],
          "wordCount": 14,
          "subsections": []
        },
        {
          "id": "spring-data-mongodb",
          "heading": "Spring Data MongoDB",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A part of the Spring Data project that allows developers to use MongoDB with Spring by providing repositories, annotations, and MongoTemplate."
            }
          ],
          "wordCount": 21,
          "subsections": []
        },
        {
          "id": "mongorepository",
          "heading": "MongoRepository",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "An interface provided by Spring Data MongoDB that extends PagingAndSortingRepository, enabling CRUD and custom queries on MongoDB documents."
            }
          ],
          "wordCount": 18,
          "subsections": []
        }
      ]
    },
