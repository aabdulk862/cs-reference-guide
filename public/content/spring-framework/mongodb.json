      "subsections": [
        {
          "id": "1-mongodb-dependency",
          "heading": "1. MongoDB Dependency",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "The following is added when you select MongoDB from Initializr:"
            },
            {
              "type": "code",
              "language": "xml",
              "code": "<dependency>\n    <groupId>org.springframework.boot</groupId>\n    <artifactId>spring-boot-starter-data-mongodb</artifactId>\n</dependency>",
              "runnable": false
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "2-auto-configuration",
          "heading": "2. Auto-Configuration",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Spring Boot auto-configures the MongoTemplate, MongoRepository, and MongoDB connection settings."
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "3-validation-strategy",
          "heading": "3. Validation Strategy",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Handled using regex-based checks for fields such as:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "User ID: Alphanumeric (4–15 chars)",
                "Password: Alphanumeric (8–15 chars)",
                "Email: Must match email regex",
                "Phone: 10-digit numeric"
              ]
            }
          ],
          "wordCount": 25,
          "subsections": []
        },
        {
          "id": "4-repository-layer",
          "heading": "4. Repository Layer",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Spring’s MongoRepository simplifies CRUD:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "findByUserId(String userId) auto-implements the query."
              ]
            }
          ],
          "wordCount": 9,
          "subsections": []
        }
      ]
    },
