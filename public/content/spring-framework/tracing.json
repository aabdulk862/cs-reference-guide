        {
          "type": "table",
          "headers": [
            "Feature",
            "Sleuth",
            "Zipkin"
          ],
          "rows": [
            [
              "Purpose",
              "Adds trace and span info to logs",
              "Collects and visualizes trace data"
            ],
            [
              "Data Format",
              "Logs with traceId, spanId",
              "Graphical UI, timeline of calls"
            ],
            [
              "Configuration",
              "Lightweight, add dependency",
              "Requires Zipkin server + microservice config"
            ],
            [
              "UI",
              "❌",
              "✅"
            ],
            [
              "Integration",
              "Easily integrates with Spring",
              "Integrates with Sleuth for data input"
            ]
          ]
        }
      ],
      "wordCount": 51,
      "subsections": []
    },
    {
      "id": "best-practices",
      "heading": "Best Practices",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Use correlation IDs (traceId) in logs for better debugging.",
            "Combine with Hystrix, Feign, Zuul, etc. to trace across the entire stack.",
            "Centralized log aggregation tools (like ELK or Splunk) can further improve visibility."
          ]
        }
      ],
