{
  "id": "actuator-actuator",
  "slug": "actuator",
  "title": "Actuator",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "overview",
      "heading": "Overview",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "spring-boot-actuator",
          "heading": "Spring Boot Actuator",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A Spring Boot feature that provides production-ready monitoring and management capabilities over your application via HTTP endpoints, JMX, or custom interfaces."
            }
          ],
          "wordCount": 21,
          "subsections": []
        },
        {
          "id": "purpose-of-actuator",
          "heading": "Purpose of Actuator",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "In a production environment, it is crucial to monitor:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Application health",
                "Internal metrics (memory, CPU usage, thread count, etc.)",
                "Thread dumps",
                "Environment variables",
                "Spring Beans"
              ]
            },
            {
              "type": "paragraph",
              "text": "Actuator simplifies this process by exposing endpoints to inspect and manage the running application."
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Boot/Actuator/Actuator/image.png",
              "alt": "image.png",
              "originalPath": "Actuator/image.png"
            }
          ],
          "wordCount": 39,
          "subsections": []
        }
      ]
    },
    {
      "id": "enabling-actuator",
      "heading": "Enabling Actuator",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "import-irs-project",
          "heading": "Import IRS Project",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Open Spring Tool Suite (STS) and import the project named:"
            },
            {
              "type": "paragraph",
              "text": "InfyGoBoot_SpringMVC"
            }
          ],
          "wordCount": 11,
          "subsections": []
        },
        {
          "id": "add-actuator-dependency",
          "heading": "Add Actuator Dependency",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "In pom.xml, add:"
            },
            {
              "type": "code",
              "language": "xml",
              "code": "<dependency>\n  <groupId>org.springframework.boot</groupId>\n  <artifactId>spring-boot-starter-actuator</artifactId>\n</dependency>",
              "runnable": false
            }
          ],
          "wordCount": 3,
          "subsections": []
        },
        {
          "id": "run-the-project",
          "heading": "Run the Project",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Right-click the project →"
            },
            {
              "type": "paragraph",
              "text": "Run As → Spring Boot App"
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "access-actuator-root-endpoint",
          "heading": "Access Actuator Root Endpoint",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Open your browser and navigate to:"
            },
            {
              "type": "code",
              "language": "",
              "code": "http://localhost:4343/InfyGoBoot/actuator/",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "This URL lists available endpoints like /health, /info, etc."
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Boot/Actuator/Actuator/image%201.png",
              "alt": "image.png",
              "originalPath": "Actuator/image%201.png"
            }
          ],
          "wordCount": 15,
          "subsections": []
        },
        {
          "id": "expose-all-endpoints",
          "heading": "Expose All Endpoints",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "application.properties:"
            },
            {
              "type": "code",
              "language": "",
              "code": "management.endpoints.web.exposure.include=*",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "application.yml:"
            },
            {
              "type": "code",
              "language": "yaml",
              "code": "management:\n  endpoints:\n    web:\n      exposure:\n        include: \"*\"",
              "runnable": false
            }
          ],
          "wordCount": 2,
          "subsections": []
        },
        {
          "id": "access-built-in-endpoints",
          "heading": "Access Built-in Endpoints",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Try:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Beans List: http://localhost:4343/InfyGoBoot/actuator/beans ",
                "Metrics Info: http://localhost:4343/InfyGoBoot/actuator/metrics "
              ]
            },
            {
              "type": "paragraph",
              "text": "You’ll see data like memory usage, thread count, bean details, etc."
            }
          ],
          "wordCount": 18,
          "subsections": []
        }
      ]
    },
    {
      "id": "endpoint-configuration-options",
      "heading": "Endpoint Configuration Options",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "expose-specific-endpoints",
          "heading": "Expose Specific Endpoints:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "management.endpoints.web.exposure.include=env,beans",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "hide-specific-endpoints",
          "heading": "Hide Specific Endpoints:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "management.endpoints.web.exposure.include=*\nmanagement.endpoints.web.exposure.exclude=env",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "common-built-in-endpoints",
      "heading": "Common Built-in Endpoints",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Endpoint",
            "Description"
          ],
          "rows": [
            [
              "/health",
              "Shows application health status"
            ],
            [
              "/info",
              "Displays custom app info"
            ],
            [
              "/metrics",
              "Displays app performance metrics"
            ],
            [
              "/beans",
              "Lists all loaded Spring beans"
            ],
            [
              "/env",
              "Displays environment properties"
            ],
            [
              "/threaddump",
              "Displays a thread dump"
            ],
            [
              "/mappings",
              "Shows all URL mappings"
            ],
            [
              "/loggers",
              "Logging levels of packages/classes"
            ]
          ]
        }
      ],
      "wordCount": 42,
      "subsections": []
    },
    {
      "id": "custom-endpoint-creation-example",
      "heading": "Custom Endpoint Creation Example",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Create your own custom actuator endpoint:"
        }
      ],
      "wordCount": 6,
      "subsections": [
        {
          "id": "myendpointjava",
          "heading": "MyEndpoint.java",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "import java.util.HashMap;\nimport java.util.Map;\nimport org.springframework.boot.actuate.endpoint.annotation.*;\nimport org.springframework.stereotype.Component;\n\n@Component\n@Endpoint(id=\"myendpoint\")\npublic class MyEndpoint {\n\n    private Map<String, String> myUsers = new HashMap<>();\n\n    @ReadOperation\n    public Map<String, String> features() {\n        myUsers.put(\"FirstUser\", \"Abhinaya\");\n        myUsers.put(\"SecondUser\", \"Viveka\");\n        return myUsers;\n    }\n\n    @WriteOperation\n    public String writeOperation(String name) {\n        return name + \" \\t in HTTP POST method\";\n    }\n\n    @DeleteOperation\n    public String deleteOperation() {\n        return \"HTTP DELETE method\";\n    }\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "http-method-mapping-for-custom-endpoint",
      "heading": "HTTP Method Mapping for Custom Endpoint",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Annotation",
            "HTTP Method",
            "Description"
          ],
          "rows": [
            [
              "@ReadOperation",
              "GET",
              "Read operation (data fetch)"
            ],
            [
              "@WriteOperation",
              "POST",
              "Write operation (create/update)"
            ],
            [
              "@DeleteOperation",
              "DELETE",
              "Delete operation"
            ]
          ]
        }
      ],
      "wordCount": 19,
      "subsections": [
        {
          "id": "access-your-custom-endpoint",
          "heading": "Access your custom endpoint:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "http://localhost:4343/InfyGoBoot/actuator/myendpoint",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "important-notes-on-actuator-in-spring-boot-2x",
      "heading": "Important Notes on Actuator in Spring Boot 2.x",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "All actuator endpoints are now available under the base path /actuator.",
            "JSON responses are more structured and readable.",
            "Endpoints are disabled by default, and must be explicitly enabled.",
            "User-defined endpoints must use @Endpoint, @ReadOperation, etc."
          ]
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "example-use-cases",
      "heading": "Example Use Cases",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "health-check",
          "heading": "Health Check",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use /health in monitoring tools (like Prometheus, Grafana, etc.) to auto-check the service status."
            }
          ],
          "wordCount": 14,
          "subsections": []
        },
        {
          "id": "view-application-metrics",
          "heading": "View Application Metrics",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Navigate to /metrics for insights on:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Memory usage",
                "Heap size",
                "Active threads",
                "GC activity",
                "HTTP request counts"
              ]
            }
          ],
          "wordCount": 17,
          "subsections": []
        },
        {
          "id": "debug-bean-configuration",
          "heading": "Debug Bean Configuration",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use /beans to see the internal wiring of Spring components."
            }
