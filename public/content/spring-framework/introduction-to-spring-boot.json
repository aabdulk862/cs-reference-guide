      "content": [
        {
          "type": "paragraph",
          "text": "InfyGo IRS Application"
        },
        {
          "type": "paragraph",
          "text": "An online travel reservation system by InfyGo built using traditional Spring framework."
        }
      ],
      "wordCount": 15,
      "subsections": [
        {
          "id": "irs-functionalities",
          "heading": "IRS Functionalities",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Architecture: MVC with 3-tier structure",
                "Technologies: Java, Spring Core, Spring MVC, Spring Data JPA, JSP, HTML",
                "Database: MySQL",
                "Configuration: XML + Annotations",
                "Build System: Manual",
                "Server: Apache Tomcat"
              ]
            }
          ],
          "wordCount": 28,
          "subsections": []
        },
        {
          "id": "challenges-in-traditional-spring-app",
          "heading": "Challenges in Traditional Spring App",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Aspect",
                "Traditional IRS",
                "Spring Boot IRS"
              ],
              "rows": [
                [
                  "Application Server",
                  "Requires external Tomcat server, licensing costs",
                  "Embedded server (Tomcat/Jetty), no licensing needed"
                ],
                [
                  "Dependencies",
                  "Manually manage ~50 JAR files, update for each Spring version",
                  "Starters manage dependencies automatically"
                ],
                [
                  "Configuration",
                  "XML and .properties heavy, manual customization",
                  "Auto-configuration, profile-based customization"
                ],
                [
                  "Upgrades",
                  "Tedious; each JAR must be updated manually",
                  "Update Spring version in pom.xml, rest auto-managed"
                ],
                [
                  "Monitoring",
                  "Requires custom coding for health checks",
                  "Actuator provides built-in endpoints for health, metrics"
                ]
              ]
            }
          ],
          "wordCount": 74,
          "subsections": []
        }
      ]
