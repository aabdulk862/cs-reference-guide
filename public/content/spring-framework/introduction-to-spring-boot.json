        {
          "id": "auto-configuration",
          "heading": "Auto Configuration",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: Automatically configures Spring application based on the libraries on the classpath.",
                "Example: If spring-boot-starter-web is present, Spring Boot configures MVC, Tomcat, and related settings automatically."
              ]
            }
          ],
          "wordCount": 26,
          "subsections": []
        },
        {
          "id": "actuator",
          "heading": "Actuator",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: Provides production-ready features like monitoring, metrics, and health checks.",
                "Example: Exposes endpoints like /actuator/health, /actuator/metrics."
              ]
            }
          ],
          "wordCount": 16,
