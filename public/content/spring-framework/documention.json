            ],
            [
              "API testing capability",
              "❌ No",
              "✅ Yes"
            ]
          ]
        }
      ],
      "wordCount": 51,
      "subsections": [
        {
          "id": "best-practices-for-rest-api-documentation",
          "heading": "Best Practices for REST API Documentation",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use OpenAPI (Swagger) for real-time and interactive documentation",
                "Keep your documentation up to date with API changes",
                "Include examples for request/response payloads",
                "Clearly define error codes and messages",
                "Organize endpoints with tags for better navigation",
                "Document authentication methods (e.g., JWT, OAuth)"
              ]
            }
          ],
          "wordCount": 41,
          "subsections": []
        },
        {
          "id": "example-simple-openapi-yaml-snippet",
          "heading": "Example: Simple OpenAPI YAML Snippet",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "yaml",
              "code": "openapi: 3.0.0\ninfo:\n  title: Customer API\n  version: 1.0.0\npaths:\n  /customers/{id}:\n    get:\n      summary: Get customer by ID\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Success\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/Customer'\ncomponents:\n  schemas:\n    Customer:\n      type: object\n      properties:\n        id:\n          type: string\n        name:\n          type: string",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    }
