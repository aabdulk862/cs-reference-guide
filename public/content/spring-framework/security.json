    {
      "id": "basic-authentication-in-memory",
      "heading": "Basic Authentication (In-Memory)",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Steps:"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Add the Spring Boot Security dependency (same as above).",
            "Create a configuration class extending WebSecurityConfigurerAdapter (deprecated in newer versions, replaced by SecurityFilterChain): @Configuration\n@EnableWebSecurity\npublic class SecurityConfig extends WebSecurityConfigurerAdapter {\n    @Override\n    protected void configure(AuthenticationManagerBuilder auth) throws Exception {\n        auth.inMemoryAuthentication()\n            .withUser(\"admin\")\n            .password(\"{noop}admin123\")\n            .roles(\"USER\");\n    }\n\n    @Override\n    protected void configure(HttpSecurity http) throws Exception {\n        http\n          .authorizeRequests()\n          .anyRequest().authenticated()\n          .and()\n          .httpBasic();\n    }\n}",
            "Start the application and access a protected URL. "
          ]
        },
        {
          "type": "paragraph",
          "text": "Use Case:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Quick prototyping or internal tools without external user databases."
          ]
        }
      ],
      "wordCount": 78,
      "subsections": []
