      "id": "default-authentication-spring-boot",
      "heading": "Default Authentication (Spring Boot)",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Steps:"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Add Spring Security dependency: <dependency>\n  <groupId>org.springframework.boot</groupId>\n  <artifactId>spring-boot-starter-security</artifactId>\n</dependency>\n",
            "Build the application (mvn clean install).",
            "On running the app: "
          ]
        },
        {
          "type": "paragraph",
          "text": "Use Case:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
