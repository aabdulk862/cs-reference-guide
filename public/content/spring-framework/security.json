  "sections": [
    {
      "id": "what-is-software-security",
      "heading": "What is Software Security?",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Software Security is the practice of designing and implementing software with measures that protect it from malicious attacks and unauthorized access."
        },
        {
          "type": "paragraph",
          "text": "These measures include:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Authentication",
            "Authorization",
            "Encryption",
            "Input validation",
            "Secure coding practices"
          ]
        },
        {
          "type": "paragraph",
          "text": "Purpose: To ensure the confidentiality, integrity, and availability (CIA triad) of data and software systems."
        }
      ],
      "wordCount": 47,
      "subsections": []
    },
    {
      "id": "why-is-software-security-important",
      "heading": "Why is Software Security Important?",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Modern life relies heavily on software for:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Banking and financial transactions",
            "Health and medical records",
            "Social media and communication",
            "Business operations",
            "Government and defense systems"
          ]
        },
        {
          "type": "paragraph",
          "text": "A breach in software security can result in:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Identity theft",
            "Financial loss",
            "Legal consequences",
            "Damage to reputation"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example: The 2017 Equifax data breach exposed personal data of over 147 million people due to a web application vulnerability."
        }
      ],
      "wordCount": 62,
      "subsections": []
    },
    {
      "id": "types-of-software-security",
      "heading": "Types of Software Security",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Software security methods differ based on the application architecture."
        }
      ],
      "wordCount": 9,
      "subsections": []
    },
    {
      "id": "1-web-application-security",
      "heading": "1. Web Application Security",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Security applied to full-stack web applications that include:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "UI layer (e.g., HTML, JavaScript)",
            "Service layer (e.g., Java, Python)",
            "Database layer"
          ]
        },
        {
          "type": "paragraph",
          "text": "Key Characteristics:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Intended for human users.",
            "Output rendered using HTML/CSS/JS and displayed in a browser.",
            "Example: Online banking portal, e-commerce sites."
          ]
        }
      ],
      "wordCount": 41,
      "subsections": []
    },
    {
      "id": "2-rest-api-security",
      "heading": "2. REST API Security",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Security focused on RESTful APIs—which provide data services without UI."
        },
        {
          "type": "paragraph",
          "text": "Key Characteristics:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Meant for machine-to-machine or API-to-API communication.",
            "Returns JSON or XML data.",
            "Example: Weather API, Payment gateway API."
          ]
        }
      ],
      "wordCount": 29,
      "subsections": []
    },
