              "type": "list",
              "ordered": true,
              "items": [
                "@EnableAsync  @SpringBootApplication\n@EnableAsync\npublic class MyApp {}",
                "@Async  @Async\npublic void sendEmail(String to) {\n    // Email logic here\n}"
              ]
            }
          ],
