      "subsections": []
    },
    {
      "id": "definition",
      "heading": "Definition:",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "An API Gateway is a server that acts as an entry point for all clients and forwards requests to appropriate microservices."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Microservices/Gateway/Gateway/image%201.png",
          "alt": "image.png",
          "originalPath": "Gateway/image%201.png"
        }
      ],
      "wordCount": 21,
      "subsections": []
    },
    {
      "id": "benefits",
      "heading": "Benefits:",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Centralized entry point for clients.",
            "Intelligent routing to microservices.",
            "Request aggregation and protocol translation.",
            "Security, load balancing, and caching."
          ]
        }
      ],
      "wordCount": 19,
      "subsections": []
    },
    {
      "id": "reverse-proxy",
      "heading": "Reverse Proxy:",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Reverse Proxy: Forwards requests from client to internal servers.",
            "Example: Zuul or Spring Cloud Gateway."
          ]
        }
      ],
      "wordCount": 15,
      "subsections": []
    },
    {
      "id": "definition",
      "heading": "Definition:",
      "level": 3,
      "content": [
        {
          "type": "paragraph",
          "text": "A Backend for Frontend (BFF) is a variant of the API Gateway pattern that provides client-specific APIs."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Microservices/Gateway/Gateway/image%202.png",
          "alt": "image.png",
          "originalPath": "Gateway/image%202.png"
        }
      ],
      "wordCount": 17,
      "subsections": []
    },
