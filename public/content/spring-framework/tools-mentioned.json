  "title": "Tools Mentioned",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "scenario",
      "heading": "Scenario:",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "The UI application needs to communicate with multiple microservices.",
            "Microservices are hosted in the cloud, where hostnames and ports can change dynamically (e.g., due to autoscaling).",
            "Direct communication from UI → Microservices is not sustainable."
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Microservices/Gateway/Gateway/c58eab5e-554f-4bb8-8d3a-e91f4db64428.png",
          "alt": "image.png",
          "originalPath": "Gateway/c58eab5e-554f-4bb8-8d3a-e91f4db64428.png"
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "issues-with-direct-ui-to-microservices-communication",
      "heading": "Issues with Direct UI-to-Microservices Communication:",
      "level": 3,
      "content": [
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Host/Port Volatility: ",
            "Client Responsibilities: ",
            "Refactoring Impact: ",
            "Protocol Compatibility: ",
            "High Network Overhead: "
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Microservices/Gateway/Gateway/image.png",
          "alt": "image.png",
