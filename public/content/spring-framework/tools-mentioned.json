    {
      "id": "load-balancing-resilience",
      "heading": "Load Balancing & Resilience",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Zuul uses Ribbon (client-side load balancer) by default.",
            "Hystrix is used for fault tolerance. "
          ]
        }
      ],
      "wordCount": 14,
      "subsections": [
        {
          "id": "adding-a-global-prefix",
          "heading": "Adding a Global Prefix:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "zuul.prefix=/infytel",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "All endpoints will be accessed as:"
