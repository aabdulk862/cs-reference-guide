        {
          "id": "-fix",
          "heading": "✅ Fix:",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Add:"
            },
            {
              "type": "code",
              "language": "",
              "code": "ribbon.ReadTimeout=6000\n",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "This ensures Ribbon (used by Zuul) waits long enough before timing out."
