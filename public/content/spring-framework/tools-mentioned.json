        },
        {
          "id": "custom-route-names",
          "heading": "Custom Route Names:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "",
              "code": "zuul.routes.customer.path=/customers/*\nzuul.routes.customer.strip-prefix=false\nzuul.routes.customer.service-id=CustomerMS",
