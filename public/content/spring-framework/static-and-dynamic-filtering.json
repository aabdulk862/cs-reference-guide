    },
    {
      "id": "best-practices",
      "heading": "Best Practices",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Use static filtering for security-critical fields (e.g., passwords).",
            "Use dynamic filtering when flexibility is required for different use cases.",
            "Combine with Spring Security to show/hide data based on user roles."
          ]
        }
      ],
