{
  "id": "spring-rest-advanced-security-topics",
  "slug": "advanced-security-topics",
  "title": "Advanced Security Topics",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "introduction-to-security-in-spring-rest",
      "heading": "Introduction to Security in Spring REST",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "how-is-security-handled-in-spring-rest-applications",
          "heading": "How is Security Handled in Spring REST Applications?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Spring Security provides a comprehensive and customizable framework for authentication and authorization. In Spring REST, security can be handled in multiple ways:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "HTTP Basic Authentication",
                "Form-based login",
                "Token-based Authentication (e.g., JWT)",
                "OAuth2/OIDC",
                "Role-Based Access Control (RBAC)",
                "Attribute-Based Access Control (ABAC)"
              ]
            },
            {
              "type": "paragraph",
              "text": "Spring Security uses filters and security contexts to manage access to endpoints."
            }
          ],
          "wordCount": 52,
          "subsections": []
        },
        {
          "id": "what-is-authentication",
          "heading": "What is Authentication?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Definition: Authentication is the process of verifying the identity of a user or system."
            },
            {
              "type": "paragraph",
              "text": "In Spring REST: Authentication is typically performed through login credentials or tokens, validated using Spring Security."
            },
            {
              "type": "blockquote",
              "text": "Example: A user logs in with a username/password and receives a JWT token to access secure endpoints."
            }
          ],
          "wordCount": 47,
          "subsections": []
        },
        {
          "id": "why-is-authentication-important",
          "heading": "Why is Authentication Important?",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Ensures only authorized users access resources.",
                "Protects sensitive data.",
                "Enables auditing and access control.",
                "Prevents unauthorized access and potential breaches."
              ]
            }
          ],
          "wordCount": 20,
          "subsections": []
        }
      ]
    },
    {
      "id": "implementing-oauth2-authentication",
      "heading": "Implementing OAuth2 Authentication",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-is-oauth2-authentication",
          "heading": "What is OAuth2 Authentication?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "OAuth2 is an authorization framework that allows applications to access resources on behalf of users without sharing credentials."
            },
            {
              "type": "paragraph",
              "text": "How It Works in Spring REST:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Client requests access token from Authorization Server.",
                "Access token is used to call protected resources on Resource Server."
              ]
            },
            {
              "type": "blockquote",
              "text": "Spring Security provides support for both Authorization Server and Resource Server roles."
            }
          ],
          "wordCount": 54,
          "subsections": []
        },
        {
          "id": "main-components-of-oauth2-in-spring",
          "heading": "Main Components of OAuth2 in Spring",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Resource Owner: The user",
                "Client: Application requesting access",
                "Authorization Server: Issues tokens (e.g., Keycloak)",
                "Resource Server: Serves protected APIs (Spring REST)"
              ]
            }
          ],
          "wordCount": 21,
          "subsections": []
        },
        {
          "id": "configuring-oauth2-server-example-with-spring-boot-3",
          "heading": "Configuring OAuth2 Server (Example with Spring Boot 3+)",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\npublic SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {\n    http\n        .authorizeHttpRequests(auth -> auth\n            .requestMatchers(\"/api/public\").permitAll()\n            .anyRequest().authenticated()\n        )\n        .oauth2ResourceServer(oauth2 -> oauth2.jwt());\n    return http.build();\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "integrating-google-oauth2",
          "heading": "Integrating Google OAuth2",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "application.yml"
            },
            {
              "type": "code",
              "language": "yaml",
              "code": "spring:\n  security:\n    oauth2:\n      client:\n        registration:\n          google:\n            client-id: YOUR_CLIENT_ID\n            client-secret: YOUR_CLIENT_SECRET\n            redirect-uri: \"{baseUrl}/login/oauth2/code/{registrationId}\"\n            scope: email, profile",
              "runnable": false
            }
          ],
          "wordCount": 1,
          "subsections": []
        },
        {
          "id": "oauth2-grant-types",
          "heading": "OAuth2 Grant Types",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Authorization Code (Browser apps)",
                "Client Credentials (Machine-to-Machine)",
                "Password Credentials (Deprecated)",
                "Implicit (Deprecated)"
              ]
            },
            {
              "type": "blockquote",
              "text": "Choose based on client type and flow."
            }
          ],
          "wordCount": 19,
          "subsections": []
        },
        {
          "id": "token-management-and-storage",
          "heading": "Token Management and Storage",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Store in memory, DB, or Redis.",
                "JWT eliminates need to store tokens."
              ]
            },
            {
              "type": "blockquote",
              "text": "Example: Use JwtDecoder bean for validation."
            }
          ],
          "wordCount": 18,
          "subsections": []
        },
        {
          "id": "oauth2-authentication-flow",
          "heading": "OAuth2 Authentication Flow",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "User logs in → Authorization Server.",
                "Server returns Authorization Code.",
                "Client exchanges code for Access Token.",
                "Token used to call protected APIs."
              ]
            }
          ],
          "wordCount": 22,
          "subsections": []
        },
        {
          "id": "securing-endpoints-with-oauth2",
          "heading": "Securing Endpoints with OAuth2",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@GetMapping(\"/user\")\n@PreAuthorize(\"hasAuthority('SCOPE_read')\")\npublic String getUser() {\n    return \"User Info\";\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "oauth2-scopes",
          "heading": "OAuth2 Scopes",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Scopes define permissions requested by the client."
            },
            {
              "type": "blockquote",
              "text": "Example: read, write, admin"
            }
          ],
          "wordCount": 11,
          "subsections": []
        },
        {
          "id": "handling-token-expiry-and-refresh",
          "heading": "Handling Token Expiry and Refresh",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Include refresh_token in response.",
                "Use it to get a new access token."
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "curl -X POST https://auth-server/token \\\n  -d grant_type=refresh_token \\\n  -d refresh_token=xyz",
              "runnable": false
            }
          ],
          "wordCount": 12,
          "subsections": []
        },
        {
          "id": "best-practices-for-oauth2",
          "heading": "Best Practices for OAuth2",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use HTTPS",
                "Short-lived access tokens",
                "Secure client secrets",
                "Validate tokens properly"
              ]
            }
          ],
          "wordCount": 11,
          "subsections": []
        },
        {
          "id": "jwt-in-oauth2",
          "heading": "JWT in OAuth2",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "JSON Web Tokens (JWT) are compact tokens with user claims."
            },
            {
              "type": "blockquote",
              "text": "Example payload:"
            },
            {
              "type": "code",
              "language": "json",
              "code": "{\n  \"sub\": \"user@example.com\",\n  \"scope\": \"read\"\n}",
              "runnable": false
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use JwtDecoder in Spring to verify."
              ]
            }
          ],
          "wordCount": 18,
          "subsections": []
        },
        {
          "id": "testing-oauth2",
          "heading": "Testing OAuth2",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use Postman with OAuth2 flow.",
                "Decode JWT using jwt.io",
                "Log SecurityContext for debugging"
              ]
            }
          ],
          "wordCount": 13,
          "subsections": []
        },
        {
          "id": "common-pitfalls",
          "heading": "Common Pitfalls",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Misconfigured redirect URIs",
                "Using long-lived tokens",
                "Not validating token signatures"
              ]
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "custom-authenticationauthorization",
          "heading": "Custom Authentication/Authorization",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use custom AuthenticationProvider or OAuth2UserService."
            }
          ],
          "wordCount": 5,
          "subsections": []
        }
      ]
    },
    {
      "id": "token-based-authentication",
      "heading": "Token-Based Authentication",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-is-token-based-authentication",
          "heading": "What is Token-Based Authentication?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Tokens represent user identity and are passed with each request."
            },
            {
              "type": "blockquote",
              "text": "Stateless; does not rely on sessions."
            }
          ],
          "wordCount": 16,
          "subsections": []
        },
        {
          "id": "advantages-over-sessions",
          "heading": "Advantages over Sessions",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Stateless and scalable",
                "Works with mobile & SPA clients",
                "Better suited for microservices"
              ]
            }
          ],
          "wordCount": 13,
          "subsections": []
        },
        {
          "id": "generating-tokens",
          "heading": "Generating Tokens",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use JWT libraries like jjwt or Nimbus."
            },
            {
              "type": "code",
              "language": "java",
              "code": "String token = Jwts.builder()\n    .setSubject(\"user@example.com\")\n    .setIssuedAt(new Date())\n    .setExpiration(new Date(System.currentTimeMillis() + 1000 * 60 * 60))\n    .signWith(secretKey)\n    .compact();",
              "runnable": false
            }
          ],
          "wordCount": 7,
          "subsections": []
        },
        {
          "id": "types-of-tokens",
          "heading": "Types of Tokens",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "JWT (self-contained, stateless)",
                "Opaque tokens (stored server-side)"
              ]
            }
          ],
          "wordCount": 7,
          "subsections": []
        },
        {
          "id": "secure-storage",
          "heading": "Secure Storage",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Store in HTTP-only cookies or Authorization headers.",
                "Never expose in URLs."
              ]
            }
          ],
          "wordCount": 11,
          "subsections": []
        },
        {
          "id": "token-validation",
          "heading": "Token Validation",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "Jwts.parser()\n    .setSigningKey(secretKey)\n    .parseClaimsJws(token);",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "expiration-and-refresh",
          "heading": "Expiration and Refresh",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use refresh tokens.",
                "Validate expiration in every request."
              ]
            }
          ],
          "wordCount": 8,
          "subsections": []
        },
        {
          "id": "best-practices",
          "heading": "Best Practices",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Rotate signing keys",
                "Use HTTPS",
                "Implement token blacklisting"
              ]
            }
          ],
          "wordCount": 8,
          "subsections": []
        },
        {
          "id": "role-permission-integration",
          "heading": "Role & Permission Integration",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@PreAuthorize(\"hasRole('ADMIN')\")\npublic String adminEndpoint() { ... }\n",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "common-pitfalls",
          "heading": "Common Pitfalls",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Not revoking old tokens",
                "Not checking token signature"
              ]
            }
          ],
          "wordCount": 8,
          "subsections": []
        },
        {
          "id": "token-revocation",
          "heading": "Token Revocation",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use blacklist or token store.",
                "Use short expiry and rotate."
              ]
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "stateless-handling",
          "heading": "Stateless Handling",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Store auth info in JWT; validate on every request."
            }
          ],
          "wordCount": 9,
          "subsections": []
        },
        {
          "id": "third-party-identity-integration",
          "heading": "Third-Party Identity Integration",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use OAuth2 with SSO providers like Okta, Google, etc."
            }
          ],
          "wordCount": 9,
          "subsections": []
        },
        {
          "id": "customization",
          "heading": "Customization",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Build custom TokenProvider and AuthenticationFilter."
            }
          ],
          "wordCount": 5,
          "subsections": []
        }
      ]
    },
    {
      "id": "access-control-rbac-abac",
      "heading": "Access Control: RBAC & ABAC",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-is-rbac",
          "heading": "What is RBAC?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Role-Based Access Control assigns permissions based on user roles."
            },
            {
              "type": "blockquote",
              "text": "E.g., \"admin\", \"user\", \"manager\""
            }
          ],
          "wordCount": 13,
          "subsections": []
        },
        {
          "id": "what-is-abac",
          "heading": "What is ABAC?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Attribute-Based Access Control uses user and resource attributes."
            },
            {
              "type": "blockquote",
              "text": "E.g., Department = \"HR\", ResourceOwner = true"
            }
          ],
          "wordCount": 15,
          "subsections": []
        },
        {
          "id": "rbac-in-spring",
          "heading": "RBAC in Spring",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Use @PreAuthorize(\"hasRole('ADMIN')\")",
                "Roles mapped from database or user claims"
              ]
            }
          ],
          "wordCount": 9,
          "subsections": []
        },
        {
          "id": "defining-roles",
          "heading": "Defining Roles",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Override\nprotected void configure(AuthenticationManagerBuilder auth) {\n    auth.inMemoryAuthentication()\n        .withUser(\"admin\").password(\"admin123\").roles(\"ADMIN\");\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "role-hierarchies",
          "heading": "Role Hierarchies",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Bean\nRoleHierarchy hierarchy() {\n    RoleHierarchyImpl impl = new RoleHierarchyImpl();\n    impl.setHierarchy(\"ROLE_ADMIN > ROLE_USER\");\n    return impl;\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "dynamic-roles",
          "heading": "Dynamic Roles",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Store in DB and fetch via UserDetailsService."
            }
          ],
          "wordCount": 7,
          "subsections": []
        },
        {
          "id": "abac-in-spring",
          "heading": "ABAC in Spring",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Use AccessDecisionVoter or @PostAuthorize."
            }
          ],
          "wordCount": 4,
          "subsections": []
        },
        {
          "id": "defining-attributes",
          "heading": "Defining Attributes",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Custom PermissionEvaluator can be used:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "@PreAuthorize(\"@permissionEvaluator.hasAccess(authentication, #entity)\")",
              "runnable": false
            }
          ],
          "wordCount": 5,
          "subsections": []
        },
        {
          "id": "abac-policies",
          "heading": "ABAC Policies",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Define business rules like:"
            },
            {
              "type": "blockquote",
              "text": "Only allow users to access their own records."
            }
          ],
          "wordCount": 12,
          "subsections": []
        },
        {
          "id": "dynamic-abac",
          "heading": "Dynamic ABAC",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Fetch user or resource metadata at runtime to decide access."
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "best-practices-for-rbacabac",
          "heading": "Best Practices for RBAC/ABAC",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Keep role/attribute logic centralized",
                "Avoid hardcoding",
                "Use config-driven roles/policies"
              ]
            }
          ],
          "wordCount": 9,
          "subsections": []
        }
      ]
    }
