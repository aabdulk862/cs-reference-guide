{
  "id": "handling-data-handling-data",
  "slug": "handling-data",
  "title": "Handling Data",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "mapping-request-body-to-java-objects",
      "heading": "Mapping Request Body to Java Objects",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-is-request-body",
          "heading": "What is Request Body?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "The request body in a RESTful web service contains data sent by the client to the server. Common formats:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "JSON (application/json)",
                "XML (application/xml)"
              ]
            },
            {
              "type": "paragraph",
              "text": "Example JSON:"
            },
            {
              "type": "code",
              "language": "json",
              "code": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\"\n}",
              "runnable": false
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Rest/Handling Data/Handling%20Data/6863f6f3-b7b6-4a07-bbe0-3b542586f5b1.png",
              "alt": "image.png",
              "originalPath": "Handling%20Data/6863f6f3-b7b6-4a07-bbe0-3b542586f5b1.png"
            }
          ],
          "wordCount": 25,
          "subsections": []
        },
        {
          "id": "mapping-request-body-to-java-objects",
          "heading": "Mapping Request Body to Java Objects",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "To map the request body to a Java object, Spring provides the @RequestBody annotation."
            }
          ],
          "wordCount": 14,
          "subsections": []
        },
        {
          "id": "requestbody",
          "heading": "@RequestBody",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Binds the HTTP request body to a transfer or domain object.",
                "Internally uses HTTP message converters (e.g., Jackson for JSON, JAXB for XML)."
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "@PostMapping(\"/customers\")\npublic ResponseEntity<String> createCustomer(@RequestBody Customer customer) {\n    // customer object populated from request body\n    return ResponseEntity.ok(\"Customer created\");\n}",
              "runnable": false
            }
          ],
          "wordCount": 23,
          "subsections": []
        },
        {
          "id": "xml-support",
          "heading": "XML Support",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "To map XML to Java objects:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Annotate the class with @XmlRootElement."
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "@XmlRootElement\npublic class Customer {\n    private String name;\n    private String email;\n    // getters and setters\n}",
              "runnable": false
            },
            {
              "type": "blockquote",
              "text": "JSON mapping does not need extra annotations because Spring Boot defaults to JSON format using Jackson."
            }
          ],
          "wordCount": 27,
          "subsections": []
        }
      ]
    },
    {
      "id": "handling-multiple-formats-json-and-xml",
      "heading": "Handling Multiple Formats: JSON and XML",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "consumes-and-produces-attributes",
          "heading": "consumes and produces Attributes",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Used in mapping annotations to control data formats:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "consumes – what the method can accept",
                "produces – what the method can return"
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "@PostMapping(value = \"/customers\", consumes = \"application/json\", produces = \"application/xml\")\npublic ResponseEntity<Customer> createCustomer(@RequestBody Customer customer) {\n    return ResponseEntity.ok(customer);\n}",
              "runnable": false
            },
            {
              "type": "blockquote",
              "text": "If consumes is not set, Spring infers format from the Content-Type header."
            }
          ],
          "wordCount": 34,
          "subsections": []
        }
      ]
    },
    {
      "id": "internals-of-requestbody",
      "heading": "Internals of @RequestBody",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Uses HTTP Message Converters (like MappingJackson2HttpMessageConverter for JSON).",
            "Converter is selected based on Content-Type and the Java type."
          ]
        },
        {
          "type": "paragraph",
          "text": "If @RequestBody is used and no format is explicitly set, Spring assumes JSON by default."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Rest/Handling Data/Handling%20Data/image.png",
          "alt": "image.png",
          "originalPath": "Handling%20Data/image.png"
        }
      ],
      "wordCount": 33,
      "subsections": []
    },
    {
      "id": "responseentity-customizing-responses",
      "heading": "ResponseEntity: Customizing Responses",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "why-use-responseentity",
          "heading": "Why use ResponseEntity?",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Set HTTP Status Codes ",
                "Set Headers ",
                "Send Any Data Format "
              ]
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "usage-examples",
          "heading": "Usage Examples",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Basic:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "return ResponseEntity.ok(customer);",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "With status and body:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "return new ResponseEntity<>(\"Success\", HttpStatus.CREATED);",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Error Response:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "return ResponseEntity.badRequest().body(new ErrorDto(\"Invalid input\"));",
              "runnable": false
            }
          ],
          "wordCount": 7,
          "subsections": []
        }
      ]
    },
    {
      "id": "mapping-date-and-time-in-spring-boot",
      "heading": "Mapping Date and Time in Spring Boot",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "why-handle-datetime-carefully",
          "heading": "Why Handle Date/Time Carefully?",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Client input may vary in format (e.g., MM/DD/YYYY, DD-MM-YYYY)",
                "Internal consistency",
                "Predictable serialization/deserialization"
              ]
            }
          ],
          "wordCount": 13,
          "subsections": []
        },
        {
          "id": "java-8-time-classes-in-json",
          "heading": "Java 8 Time Classes in JSON",
          "level": 3,
          "content": [],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "localdatetime",
          "heading": "LocalDateTime",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Format: \"2001-08-10T10:30:00\""
            }
          ],
          "wordCount": 2,
          "subsections": []
        },
        {
          "id": "localdate",
          "heading": "LocalDate",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Format: \"2001-08-10\""
            }
          ],
          "wordCount": 2,
          "subsections": []
        },
        {
          "id": "using-jsonformat",
          "heading": "Using @JsonFormat",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Used to control the pattern of date/time fields:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "@JsonFormat(pattern = \"dd-MM-yyyy HH:mm:ss\")\nprivate LocalDateTime dateOfBirth;",
              "runnable": false
            }
          ],
          "wordCount": 8,
          "subsections": []
        },
        {
          "id": "dependency-needed",
          "heading": "Dependency Needed",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "If using custom formats:"
            },
            {
              "type": "code",
              "language": "xml",
              "code": "<dependency>\n  <groupId>com.fasterxml.jackson.datatype</groupId>\n  <artifactId>jackson-datatype-jsr310</artifactId>\n</dependency>",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Then register the module in a configuration class (Spring Boot does this automatically from version 2.2+)."
            }
          ],
          "wordCount": 20,
          "subsections": []
        },
        {
          "id": "is-jsonformat-mandatory",
          "heading": "Is @JsonFormat Mandatory?",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "No, but useful.",
                "Jackson defaults to ISO-8601 for LocalDate and LocalDateTime."
              ]
            }
          ],
          "wordCount": 11,
          "subsections": []
        }
      ]
    },
    {
      "id": "where-to-place-jsonformat",
      "heading": "Where to Place @JsonFormat?",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Entity Class: When storing in a database and controlling persistence format.",
            "DTO Class: When controlling how the date/time appears in API requests or responses."
          ]
        }
      ],
      "wordCount": 24,
      "subsections": []
    },
    {
      "id": "sample-mapping-customer-with-date-of-birth",
      "heading": "Sample: Mapping Customer with Date of Birth",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Customer.java"
        },
        {
          "type": "code",
          "language": "java",
          "code": "public class Customer {\n    private String name;\n    private String email;\n\n    @JsonFormat(pattern = \"dd-MM-yyyy\")\n    private LocalDate dateOfBirth;\n\n    // getters and setters\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "POST Request (JSON):"
        },
        {
          "type": "code",
          "language": "json",
          "code": "{\n  \"name\": \"John\",\n  \"email\": \"john@example.com\",\n  \"dateOfBirth\": \"10-08-2001\"\n}",
          "runnable": false
        }
      ],
      "wordCount": 4,
      "subsections": []
    },
    {
      "id": "best-practices",
      "heading": "Best Practices",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Always validate input (@Valid with DTOs).",
            "Use DTOs to separate internal models from exposed API.",
            "Use @JsonFormat for consistent date/time formats.",
            "Prefer ResponseEntity for fine-grained control over responses."
          ]
        }
      ],
      "wordCount": 28,
      "subsections": []
    }
  ],
