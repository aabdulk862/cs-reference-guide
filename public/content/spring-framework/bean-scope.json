    {
      "id": "practical-demo-setup-suggestion",
      "heading": "Practical Demo Setup Suggestion",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Java Class Definitions:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "@Component\n@Scope(\"singleton\") // or \"prototype\"\npublic class Customer {\n    public Customer() {\n        System.out.println(\"Customer Bean Created\");\n    }\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "App Config:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "@Configuration\n@ComponentScan(\"com.example\")\npublic class AppConfig {}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Main Application:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "public class App {\n    public static void main(String[] args) {\n        AnnotationConfigApplicationContext context = new AnnotationConfigApplicationContext(AppConfig.class);\n\n        Customer c1 = context.getBean(Customer.class);\n        Customer c2 = context.getBean(Customer.class);\n\n        System.out.println(c1 == c2 ? \"Same Instance\" : \"Different Instances\");\n\n        context.close();\n    }\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "👀 Expected Output:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Singleton: \"Same Instance\" (bean created once)",
            "Prototype: \"Different Instances\" (bean created each time)"
          ]
        }
      ],
      "wordCount": 23,
      "subsections": []
