    {
      "id": "tips-for-using-feign",
      "heading": "Tips for Using Feign",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Always register services with Eureka for Feign to discover them.",
            "For header forwarding (e.g., JWT token), use Feign request interceptors.",
            "Configure Feign timeouts with: feign.client.config.default.connectTimeout=5000\nfeign.client.config.default.readTimeout=5000"
          ]
        }
      ],
      "wordCount": 26,
      "subsections": []
