  "title": "Declarative Client",
  "category": "Spring Framework",
  "sections": [
    {
      "id": "rest-communication-in-microservices",
      "heading": "REST Communication in Microservices",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "In a microservices architecture, services often need to communicate with each other via REST calls. The traditional way to do this in Spring is by using RestTemplate."
        }
      ],
      "wordCount": 27,
      "subsections": []
    },
    {
      "id": "limitations-of-resttemplate",
      "heading": "Limitations of RestTemplate",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "drawbacks",
          "heading": "Drawbacks:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Verbose Syntax: ",
                "Manual Load Balancing: ",
                "Circuit Breaker Integration: ",
                "Header Forwarding Issue: "
              ]
            }
          ],
          "wordCount": 11,
          "subsections": []
        }
      ]
    },
    {
      "id": "solution-feign-client-netflix",
      "heading": "Solution: Feign Client (Netflix)",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "what-is-feign",
          "heading": "What is Feign?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Feign is a declarative REST client developed by Netflix. With Feign, you write interfaces, and Feign automatically generates implementations at runtime to communicate with other microservices."
            }
          ],
          "wordCount": 26,
          "subsections": []
        },
        {
          "id": "why-declarative",
          "heading": "Why \"Declarative\"?",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "You declare how the service should look and let Feign handle the implementation."
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Spring Microservices/Declarative Client/Declarative%20Client/47a27da7-82d9-4868-986f-097cca7358c9.png",
              "alt": "image.png",
              "originalPath": "Declarative%20Client/47a27da7-82d9-4868-986f-097cca7358c9.png"
            }
          ],
          "wordCount": 13,
          "subsections": []
        }
      ]
    },
    {
      "id": "benefits-of-feign-client",
      "heading": "Benefits of Feign Client",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Feature",
            "Feign Capability"
          ],
          "rows": [
            [
              "Less Boilerplate",
              "Declare interfaces; no need for manual HTTP handling"
            ],
            [
              "Load Balancing",
              "Built-in Ribbon integration"
            ],
            [
              "Circuit Breaker",
              "Works seamlessly with Hystrix or Resilience4j"
            ],
            [
              "Header Propagation",
              "Easily configurable via interceptors"
            ],
            [
              "Cleaner Code",
              "No manual error handling or object mapping"
            ]
          ]
        }
      ],
      "wordCount": 41,
      "subsections": []
    },
    {
      "id": "adding-feign-to-your-project",
      "heading": "Adding Feign to Your Project",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "add-dependency-in-pomxml-customerms",
          "heading": "Add Dependency in pom.xml (CustomerMS):",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "xml",
              "code": "<dependency>\n    <groupId>org.springframework.cloud</groupId>\n    <artifactId>spring-cloud-starter-openfeign</artifactId>\n</dependency>",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "enable-feign-clients-in-main-class",
          "heading": "Enable Feign Clients in Main Class:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@SpringBootApplication\n@EnableFeignClients\npublic class CustomerMSApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(CustomerMSApplication.class, args);\n    }\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "creating-a-feign-client",
      "heading": "Creating a Feign Client",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "define-the-interface",
          "heading": "Define the Interface:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@FeignClient(\"PlanMS\")\npublic interface CustPlanFeign {\n\n    @RequestMapping(value=\"/plans/{planId}\", method = RequestMethod.GET)\n    PlanDTO getSpecificPlan(@PathVariable(\"planId\") int planId);\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "explanation",
          "heading": "Explanation:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "@FeignClient(\"PlanMS\"): ",
                "@RequestMapping(...): "
              ]
            }
          ],
          "wordCount": 2,
          "subsections": []
        },
        {
          "id": "autowire-and-use-the-client",
          "heading": "Autowire and Use the Client:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Autowired\nCustPlanFeign planFeign;\n\npublic void fetchPlan(int planId) {\n    PlanDTO plan = planFeign.getSpecificPlan(planId);\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "feign-load-balancing-circuit-breaker",
      "heading": "Feign + Load Balancing + Circuit Breaker",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "load-balancing",
          "heading": "Load Balancing:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Automatically integrated via Ribbon.",
                "Uses service discovery from Eureka."
              ]
            }
          ],
          "wordCount": 9,
          "subsections": []
        },
        {
          "id": "circuit-breaker",
          "heading": "Circuit Breaker:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Can be integrated with Hystrix or Resilience4j.",
                "Add fallback logic in the Feign client like this:"
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "@FeignClient(name = \"PlanMS\", fallback = CustPlanFallback.class)\npublic interface CustPlanFeign {\n    @RequestMapping(value=\"/plans/{planId}\", method=RequestMethod.GET)\n    PlanDTO getSpecificPlan(@PathVariable(\"planId\") int planId);\n}",
              "runnable": false
            },
            {
              "type": "code",
              "language": "java",
              "code": "@Component\npublic class CustPlanFallback implements CustPlanFeign {\n    public PlanDTO getSpecificPlan(int planId) {\n        return new PlanDTO(); // Return default/fallback plan\n    }\n}",
              "runnable": false
            }
          ],
          "wordCount": 16,
          "subsections": []
        }
      ]
    },
    {
      "id": "example-in-a-microservices-ecosystem",
      "heading": "Example in a Microservices Ecosystem",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "CustomerMS (Customer Microservice) needs to get plan details.",
            "PlanMS (Plan Microservice) has endpoint /plans/{planId}."
          ]
        }
      ],
      "wordCount": 14,
      "subsections": [
        {
          "id": "in-customerms",
          "heading": "In CustomerMS:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@FeignClient(\"PlanMS\")\npublic interface CustPlanFeign {\n    @GetMapping(\"/plans/{planId}\")\n    PlanDTO getSpecificPlan(@PathVariable int planId);\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "calling-it",
          "heading": "Calling it:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "@Autowired\nCustPlanFeign planFeign;\n\nPlanDTO plan = planFeign.getSpecificPlan(101);",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
