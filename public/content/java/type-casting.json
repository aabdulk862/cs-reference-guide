          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "public class Calculation {\n   public static void main(String[] args) {\n      int i = 300;\n      long l = i;        // Implicit casting\n      float f = l;       // Implicit casting\n      System.out.println(\"int value :\" + i);\n      System.out.println(\"long value :\" + l);\n      System.out.println(\"float value :\" + f);\n   }\n}",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Output:"
            },
            {
              "type": "code",
              "language": "",
              "code": "int value :300\nlong value :300\nfloat value :300.0",
              "runnable": false
            }
          ],
          "wordCount": 1,
