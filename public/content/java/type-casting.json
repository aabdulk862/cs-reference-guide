        {
          "id": "narrowing",
          "heading": "Narrowing",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "public class Calculation {\n   public static void main(String[] args) {\n      double d = 234.04;\n      long l = (long) d;   // Explicit casting\n      int i = (int) l;     // Explicit casting\n      System.out.println(\"double value :\" + d);\n      System.out.println(\"long value :\" + l);\n      System.out.println(\"int value :\" + i);\n   }\n}",
              "runnable": false
