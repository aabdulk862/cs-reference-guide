    {
      "id": "package-syntax-and-structure",
      "heading": "Package Syntax and Structure",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": "package com.banking; // Must be the first non-comment statement\n\npublic interface IBank {\n  int CAUTION_MONEY = 2000;\n  String createAccount(Customer customer);\n  double issueVehicleLoan(String vehicleType, Customer customer);\n  double issueHouseLoan(Customer customer);\n  double issueGoldLoan(Customer customer);\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Rules:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "The package statement must be the first statement in the file (if used).",
            "Package names are typically in lowercase and follow the reverse domain naming convention, e.g., com.companyname.projectname.",
            "Do not use spaces or special characters in package names."
          ]
        }
      ],
      "wordCount": 39,
      "subsections": []
    },
