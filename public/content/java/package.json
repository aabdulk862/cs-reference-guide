              "Default package – includes String, System, Object"
            ],
            [
              "java.util",
              "Utility classes like ArrayList, HashMap, Date"
            ],
            [
              "java.io",
              "Classes for input and output – FileReader, BufferedReader"
            ],
            [
              "java.net",
              "Networking – Socket, InetAddress"
            ],
            [
              "java.awt",
              "GUI elements – Button, Frame, Checkbox"
            ]
          ]
        },
        {
          "type": "blockquote",
          "text": "Note: All except java.lang must be imported manually."
        }
