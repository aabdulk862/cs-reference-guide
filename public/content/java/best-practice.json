          "type": "list",
          "ordered": false,
          "items": [
            "Example: Mobile Number",
            "Criteria: "
          ]
        },
        {
          "type": "code",
          "language": "java",
          "code": "boolean validateMobileNumber(String mobileNumber) {\n    boolean valid = true;\n    int length = mobileNumber.length();\n    if (length == 10) {\n        for (int i = 0; i < length; i++) {\n            if (!Character.isDigit(mobileNumber.charAt(i))) {\n                valid = false;\n                break;\n            }\n        }\n    } else {\n        valid = false;\n    }\n    return valid;\n}",
          "runnable": false
        },
