    {
      "id": "regex-meta-characters",
      "heading": "Regex Meta Characters",
      "level": 3,
      "content": [
        {
          "type": "table",
          "headers": [
            "Symbol",
            "Description",
            "Example"
          ],
          "rows": [
            [
              "[]",
              "Match any one character inside",
              "[xyz] matches 'x', 'y' or 'z'"
            ],
            [
              "[a-z] matches any letter from 'a' to 'z'"
            ],
            [
              ".",
              "Match any single character except newline"
            ],
            [
              "Inside a bracket expression, it becomes a literal dot.",
              "b.t matches \"bat\", \"bRt\", \"b8t\", etc"
            ],
            [
              "[^]",
              "Matches a single character that is not within the brackets.",
              "[^xyz] matches 'a', '6’"
            ],
            [
              "**`",
              "`**",
              "\"or\" expression to match alternatives",
              "`bat",
              "cat` matches “bat” or “cat”"
            ],
            [
              "()",
              "Group expressions to form sub-expressions."
            ],
            [
              "Also used to capture groups.",
              "`Ma(nn",
              "tt)er` matches \"Matter\" or \"Manner\"."
            ],
            [
              "\\n",
              "Matches the nth captured sub-expression group."
            ],
            [
              "Groups are numbered from left to right.",
              "([a-z])\\\\1 matches \"dd\", \"hh\", etc."
            ]
          ]
        }
      ],
      "wordCount": 109,
      "subsections": []
    },
    {
      "id": "quantifiers",
      "heading": "Quantifiers",
      "level": 3,
      "content": [
        {
          "type": "table",
          "headers": [
            "Symbol",
            "Description",
            "Example"
          ],
          "rows": [
            [
              "?",
              "0 or 1 times",
              "Ba?t → \"Bat\", \"Bt\""
            ],
            [
              "*",
              "0 or more times",
              "10*1 → \"11\", \"1001\""
            ],
            [
              "+",
              "1 or more times",
              "10+1 → \"101\", \"1001\""
            ],
            [
              "{m}",
              "Exactly m times",
              "10{4}1 → \"100001\""
            ],
            [
              "{m,}",
              "At least m times",
              "10{3,}1"
            ],
            [
              "{m,n}",
              "Between m and n times",
              "xy{2,3}z"
            ]
          ]
        }
      ],
      "wordCount": 50,
      "subsections": []
