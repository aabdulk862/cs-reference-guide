    {
      "id": "java-distributions",
      "heading": "Java Distributions",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "OpenJDK is the reference source code for the Java platform.",
            "Java Community Process (JCP) provides the Technology Compatibility Kit (TCK) to certify builds.",
            "A build passing TCK can be described as “compatible with Java SE”."
          ]
        }
      ],
      "wordCount": 35,
      "subsections": [
        {
          "id": "certified-vendor-builds",
          "heading": "Certified Vendor Builds:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Oracle JDK & OpenJDK – by Oracle",
                "AdoptOpenJDK – by community (Amazon, Microsoft, Red Hat, etc.)",
                "Zulu – by Azul Systems",
                "Amazon Corretto – by Amazon"
              ]
            },
            {
              "type": "blockquote",
              "text": "🔸 Oracle’s OpenJDK is fully open-source. However, Oracle JDK public updates after Jan 2019 require a commercial license for business use."
            }
          ],
          "wordCount": 47,
          "subsections": []
        }
      ]
