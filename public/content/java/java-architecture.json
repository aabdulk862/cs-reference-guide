      "wordCount": 0,
      "subsections": [
        {
          "id": "-console-based-java-program-steps",
          "heading": "🖥 Console-based Java Program – Steps",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Objective: Understand how to develop & execute Java via the command line."
            },
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Open terminal and change to Desktop: cd Desktop",
                "Create a new folder: mkdir folder_name",
                "Open any text editor and write a Java program.",
                "Save it as HelloWorldApp.java inside the folder.",
                "Compile the program: javac HelloWorldApp.java (Generates HelloWorldApp.class if no errors)",
                "Run the program: java HelloWorldApp"
              ]
            }
          ],
          "wordCount": 57,
          "subsections": []
        }
      ]
    },
    {
      "id": "eclipse-ide-first-java-program",
      "heading": "Eclipse IDE – First Java Program",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Objective: Learn how to create and run Java programs using Eclipse IDE."
        }
      ],
      "wordCount": 12,
      "subsections": [
        {
          "id": "step-1-create-a-java-project",
          "heading": "Step 1: Create a Java Project",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Launch Eclipse IDE",
                "Go to: File → New → Other → Java Project",
                "Enter name (e.g., FirstJavaProgram) and click Finish"
              ]
            }
          ],
          "wordCount": 20,
          "subsections": []
        },
        {
          "id": "step-2-create-a-class",
          "heading": "Step 2: Create a Class",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Right-click on src → New → Class",
                "Name it: Main",
                "Add the following code:"
              ]
            },
            {
              "type": "code",
              "language": "java",
              "code": "public class Main {\n  public static void main(String[] args) {\n    System.out.println(\"Hello World\");\n  }\n}",
