  "category": "Java",
  "sections": [
    {
      "id": "access-protection-in-java",
      "heading": "Access Protection in Java",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Java provides access protection at two important levels: "
          ]
        }
      ],
      "wordCount": 8,
      "subsections": [
        {
          "id": "purpose",
          "heading": "Purpose:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Security: Protect sensitive data and operations from unauthorized access.",
                "Encapsulation: Hide internal details and expose only necessary functionalities.",
                "Control: Manage which parts of the program can interact with others."
              ]
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Java Programing Fundamentals/Access Modifiers/Access%20Modifiers/image.png",
              "alt": "image.png",
