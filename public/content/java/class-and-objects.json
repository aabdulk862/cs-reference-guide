      "subsections": [
        {
          "id": "-sample-program-accountjava",
          "heading": "✅ Sample Program: Account.java",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "public class Account {\n  private double balance = 500.00;          // State/variable\n  public double getBalance(int accountId) { // Behavior/method\n    // logic here\n    return balance;\n  }\n  public static void main(String[] args) {  // Main method\n    Account accnt = new Account();          // Object creation\n    double value = accnt.getBalance(123456);// Method invocation\n    System.out.println(\"The balance is: \" + value);\n  }\n}",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "-compilation-execution",
          "heading": "🧪 Compilation & Execution",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "javac Account.java     # Compiles the code and creates Account.class\njava Account           # Executes the program",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "📤 Output:"
            },
            {
              "type": "code",
              "language": "",
              "code": "The balance is: 500.0",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "📝 Notes:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "public: Required for the main method to be invoked by JVM.",
                "static: Allows the method to be invoked without creating an object.",
                "String[] args: Allows command-line arguments to be passed."
              ]
            }
