              "type": "table",
              "headers": [
                "Class",
                "Description"
              ],
              "rows": [
                [
                  "LocalDate",
                  "Date without time or zone"
                ],
                [
                  "LocalTime",
                  "Time without date or zone"
                ],
                [
                  "LocalDateTime",
                  "Date and time without zone"
                ],
                [
                  "ZonedDateTime",
                  "Date and time with time-zone"
                ],
                [
                  "Period",
                  "Represents a quantity of time in terms of years, months, and days"
                ],
                [
                  "ChronoUnit",
                  "Used for date/time arithmetic (e.g. DAYS, MONTHS, YEARS)"
                ]
              ]
            }
