    {
      "id": "localdate",
      "heading": "LocalDate",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Represents a date only, without time or zone.",
            "Immutable and thread-safe."
          ]
        },
        {
          "type": "paragraph",
          "text": "Common Methods:"
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Description"
          ],
          "rows": [
            [
              "LocalDate.now()",
              "Returns current date"
            ],
            [
              "LocalDate.of(year, month, day)",
              "Returns date with specified year, month, and day"
            ],
            [
              "LocalDate.plusDays(n)",
              "Returns date after adding days"
            ],
            [
              "LocalDate.plusMonths(n)",
              "Returns date after adding months"
            ],
            [
              "LocalDate.plusYears(n)",
              "Returns date after adding years"
            ],
            [
              "LocalDate.parse(CharSequence)",
              "Parses a string (e.g. \"2024-04-21\") into a LocalDate"
            ],
            [
              "compareTo(LocalDate)",
              "Compares two dates"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "LocalDate paySlipDate = LocalDate.now();\nSystem.out.println(paySlipDate);  // e.g., 2024-04-21",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Use Case: Reminder System"
        },
        {
          "type": "code",
          "language": "java",
          "code": "LocalDate registrationDate = LocalDate.now();\nLocalDate lastDate = registrationDate.plusDays(3);\n\nif (LocalDate.now().isAfter(lastDate)) {\n    System.out.println(\"Please take the assessment as soon as possible\");\n}",
          "runnable": false
        }
      ],
      "wordCount": 66,
      "subsections": []
    },
    {
      "id": "localtime",
      "heading": "LocalTime",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Represents only time (no date or zone).",
            "Immutable and thread-safe."
          ]
        },
        {
          "type": "paragraph",
          "text": "Common Methods:"
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Description"
          ],
          "rows": [
            [
              "LocalTime.now()",
              "Returns current time"
            ],
            [
              "LocalTime.of(hours, minutes, seconds)",
              "Returns time from values"
            ],
            [
              "plusHours(), plusMinutes(), plusSeconds()",
              "Adds time units"
            ],
            [
              "parse(CharSequence)",
              "Parses string like \"05:09\""
            ],
            [
              "compareTo(LocalTime)",
              "Compares two times"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Use Case: 1-Hour Timed Assessment"
        },
        {
          "type": "code",
          "language": "java",
          "code": "LocalTime startTime = LocalTime.now();\nLocalTime endTime = startTime.plusHours(1);\n\nwhile (true) {\n    LocalTime current = LocalTime.now();\n    if (current.getHour() == endTime.getHour() &&\n        current.getMinute() == endTime.getMinute() &&\n        current.getSecond() == endTime.getSecond()) {\n        System.out.println(\"Over\");\n        break;\n    }\n}",
          "runnable": false
        }
      ],
      "wordCount": 45,
      "subsections": []
    },
    {
      "id": "localdatetime",
      "heading": "LocalDateTime",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Represents date and time without time-zone.",
            "Immutable and thread-safe.",
            "Methods are similar to LocalDate and LocalTime."
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "LocalDateTime dateTime = LocalDateTime.now();\nSystem.out.println(dateTime);              // e.g., 2024-04-21T11:45:35.859\nSystem.out.println(dateTime.minusDays(3)); // Subtracting 3 days",
          "runnable": false
        }
      ],
      "wordCount": 17,
      "subsections": []
    },
    {
      "id": "zoneddatetime",
      "heading": "ZonedDateTime",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Represents date and time with a time-zone.",
            "Immutable and thread-safe."
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "System.out.println(ZonedDateTime.now());  // Uses system default zone\nSystem.out.println(ZonedDateTime.now(ZoneId.of(\"Europe/Athens\")));\n// Output: 2016-11-21T08:43:28.960+02:00[Europe/Athens]",
          "runnable": false
        }
      ],
      "wordCount": 11,
      "subsections": []
    },
    {
      "id": "period",
      "heading": "Period",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "java.time.Period"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Represents a date-based amount of time.",
            "Expressed in years, months, and days.",
            "Part of the java.time package.",
            "Immutable and used for date differences (not time)."
          ]
        },
        {
          "type": "paragraph",
          "text": "Common Methods:"
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Description"
          ],
          "rows": [
            [
              "Period.between(LocalDate start, LocalDate end)",
              "Returns the period (years, months, days) between two dates"
            ],
            [
              "getDays() / getMonths() / getYears()",
              "Returns the days/months/years component"
            ],
            [
              "withDays(int) / withMonths(int) / withYears(int)",
              "Returns a modified copy of the Period with updated days/months/years"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Note: Period.between() includes the start date but excludes the end date."
        },
        {
          "type": "paragraph",
          "text": "Example: Calculate LOPs (Loss of Pay Days)"
        },
        {
          "type": "code",
          "language": "java",
          "code": "public class EmployeeService {\n    public static long calculateLOPs(LocalDate startDateLOP, LocalDate endDateLOP) {\n        Period period = Period.between(startDateLOP, endDateLOP);\n        int lops = period.getDays();\n        return lops + 1; // Including start date\n    }\n}",
          "runnable": false
        }
      ],
      "wordCount": 85,
      "subsections": []
    },
    {
      "id": "chronounit",
      "heading": "ChronoUnit",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "(java.time.temporal.ChronoUnit)"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "An enum representing standard date-time units.",
            "Immutable, thread-safe, and final.",
            "Used for unit-based manipulation and calculation."
          ]
        },
        {
          "type": "paragraph",
          "text": "Common Enum Constants:"
        },
        {
          "type": "table",
          "headers": [
            "Constant",
            "Description"
          ],
          "rows": [
            [
              "DAYS",
              "Denotes day"
            ],
            [
              "MONTHS",
              "Denotes month"
            ],
            [
              "YEARS",
              "Denotes year"
            ],
            [
              "HOURS",
              "Denotes hour"
            ],
            [
              "MINUTES",
              "Denotes minute"
            ],
            [
              "SECONDS",
              "Denotes second"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Useful Methods:"
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Description"
          ],
          "rows": [
            [
              "isDateBased()",
              "Checks if unit is date-based"
            ],
            [
              "isTimeBased()",
              "Checks if unit is time-based"
            ],
            [
              "between(Temporal t1, Temporal t2)",
              "Calculates time between two temporal objects (e.g. LocalDate)"
            ]
          ]
        }
      ],
      "wordCount": 68,
      "subsections": []
    },
    {
      "id": "datetimeformatter",
      "heading": "DateTimeFormatter",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "java.time.format.DateTimeFormatter"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Used for formatting and parsing date-time objects.",
            "Provides localized formatting and pattern-based formatting."
          ]
        },
        {
          "type": "paragraph",
          "text": "Common Methods:"
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Description"
          ],
          "rows": [
            [
              "DateTimeFormatter.ofPattern(String pattern)",
              "Returns a formatter with specified pattern"
            ],
            [
              "DateTimeFormatter.ofPattern(String pattern, Locale locale)",
              "Formatter with pattern and specific locale"
            ],
            [
              "withLocale(Locale locale)",
              "Creates a copy with new locale"
            ],
            [
              "getZone()",
              "Returns overriding zone used during formatting"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Example: Formatting Date for Payslips"
        },
        {
          "type": "code",
          "language": "java",
          "code": "LocalDate paySlipDate = LocalDate.now();\nSystem.out.println(paySlipDate);                    // Output: 2016-11-21\n\nDateTimeFormatter formatter = DateTimeFormatter.ofPattern(\"dd/MMM/yyyy\");\nSystem.out.println(paySlipDate.format(formatter));  // Output: 21/Nov/2016",
          "runnable": false
        }
      ],
      "wordCount": 56,
      "subsections": []
    }
