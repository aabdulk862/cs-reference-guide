      "heading": "Iterating Over Collections",
      "level": 2,
      "content": [
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Java SE 8 Features/Lambda Expressions/Lambda%20Expressions/image%201.png",
