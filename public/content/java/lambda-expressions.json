    {
      "id": "built-in-functional-interfaces",
      "heading": "Built-In Functional Interfaces",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Located in: java.util.function"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Function Type",
            "Method Signature",
            "Input Parameters",
            "Returns",
            "When to use"
          ],
          "rows": [
            [
              "Supplier<T>",
              "T get()",
              "None",
              "Any type",
              "When something needs to be returned without passing any input"
            ],
            [
              "Consumer<T>",
              "void accept(T t)",
              "One",
              "Nothing",
              "When something needs to be consumed without returning"
            ],
            [
              "BiConsumer<T, U>",
              "void accept(T t, U u)",
              "Two",
              "Nothing",
              "When a consumer needs two input parameters"
            ],
            [
              "Predicate<T>",
              "boolean test(T t)",
              "One",
              "boolean",
              "In conditional checks"
            ],
            [
              "BiPredicate<T, U>",
              "boolean test(T t, U u)",
              "Two",
              "boolean",
              "When condition needs two inputs"
            ],
            [
              "Function<T, R>",
              "R apply(T t)",
              "One",
              "Any type",
              "When an operation needs to transform an input"
            ],
            [
              "BiFunction<T, U, R>",
              "R apply(T t, U u)",
              "Two",
              "Any type",
              "When an operation needs two inputs to return a result"
            ],
            [
              "UnaryOperator<T>",
              "T apply(T t)",
              "One",
              "Same type as input",
              "When input and output types are the same (specialized Function)"
            ],
            [
              "BinaryOperator<T>",
              "T apply(T t1, T t2)",
              "Two",
              "Same type as input",
              "When both inputs and the output are of the same type (specialized BiFunction)"
            ]
          ]
        }
      ],
