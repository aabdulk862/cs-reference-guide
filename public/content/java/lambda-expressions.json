    {
      "id": "method-references-vs-lambda-expressions",
      "heading": "Method References vs Lambda Expressions",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "example",
          "heading": "Example:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "class Employee {\n    private Integer empId;\n    private String empName;\n    private String country;\n \n    // Other fields, constructor, mutator and accessor methods\n \n    public static int compareByCountry(Employee employee1, Employee employee2) {\n        return employee1.getCountry().compareTo(employee2.getCountry());\n    }\n}\n\n// With Lambda:\nempList.sort((employee1, employee2) -> Employee.compareByCountry(employee1, employee2));\n\n// With Method Reference:\nempList.sort(Employee::compareByCountry);",
              "runnable": false
            },
            {
              "type": "table",
              "headers": [
                "Use Case",
                "Lambda",
                "Method Reference"
              ],
              "rows": [
                [
                  "Static Method",
                  "(s) -> Integer.parseInt(s)",
                  "Integer::parseInt"
                ],
                [
                  "Instance Method",
                  "(s) -> s.length()",
                  "String::length"
                ],
                [
                  "Object Method",
                  "() -> emp.getEmpId()",
                  "emp::getEmpId"
                ],
                [
                  "Constructor",
                  "(s) -> new String(s)",
                  "String::new"
                ]
              ]
            }
          ],
          "wordCount": 29,
          "subsections": []
        }
