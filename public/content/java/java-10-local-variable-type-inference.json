    {
      "id": "variable-scope-demo",
      "heading": "Variable Scope Demo",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "java",
          "code": "public class ScopeOfVariables {\n  int i = 34;               // instance variable\n  static int z;             // static variable\n\n  static {\n    z = 10;\n    System.out.println(\"inside static block: \" + z);\n  }\n\n  void test() {\n    int k = 200;            // local variable\n    System.out.println(\"local variable: \" + (k + i));\n  }\n\n  public static void main(String[] args) {\n    ScopeOfVariables obj = new ScopeOfVariables();\n    obj.test();\n    System.out.println(obj.i);\n  }\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "inside static block: 10\nlocal variable: 234\n34",
          "runnable": false
        }
      ],
      "wordCount": 1,
