  "sections": [
    {
      "id": "what-is-sonarlint",
      "heading": "What is SonarLint?",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "SonarLint is a static code analysis tool that helps you detect and fix issues in real-time as you write code in your IDE. It supports Java, JavaScript, TypeScript, Python, C#, and more."
        }
      ],
      "wordCount": 32,
      "subsections": [
        {
          "id": "supported-ides",
          "heading": "Supported IDEs",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "IntelliJ IDEA / Android Studio",
                "Eclipse",
                "Visual Studio",
                "VS Code"
              ]
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "key-features",
          "heading": "Key Features",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Instant Feedback: Highlights issues as you type.",
                "No Build Required: Analyzes code without compiling.",
                "Rules Engine: Uses rules from SonarQube/SonarCloud (if connected).",
                "Fix Suggestions: Provides tips and examples to resolve issues.",
                "Works Offline: Basic rule set works without internet or a server."
              ]
            }
          ],
          "wordCount": 42,
          "subsections": []
        },
        {
          "id": "setup-usage-intellij-vs-code-eclipse",
          "heading": "Setup & Usage: IntelliJ / VS Code / Eclipse",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Install the SonarLint plugin via the IDE marketplace.",
                "Restart the IDE.",
                "Open a project – SonarLint runs automatically.",
                "Optionally, bind to SonarQube/SonarCloud for custom rules."
              ]
            }
          ],
          "wordCount": 25,
