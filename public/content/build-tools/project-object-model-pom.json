    {
      "id": "summary",
      "heading": "Summary",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "pom.xml is the heart of a Maven project.",
            "Contains configurations for building, testing, packaging, and deploying Java applications.",
            "Enables standardized, portable, and scalable project management."
          ]
        }
