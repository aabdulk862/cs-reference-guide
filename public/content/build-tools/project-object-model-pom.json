{
  "id": "project-object-model-pom-project-object-model-pom",
  "slug": "project-object-model-pom",
  "title": "Project Object Model (POM)",
  "category": "Build Tools",
  "sections": [
    {
      "id": "what-is-pom",
      "heading": "What is POM?",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "POM stands for Project Object Model — it is the core configuration file for every Maven project."
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "It's an XML file named pom.xml located at the root directory of a Maven project.",
            "Serves as the declarative descriptor that tells Maven what to build and how to build.",
            "Created automatically when using Maven archetypes (e.g., maven-archetype-quickstart).",
            "Maven searches for pom.xml to: "
          ]
        },
        {
          "type": "blockquote",
          "text": "🗂️ Location:\nInfycart/pom.xml – created in the base directory of the project."
        }
      ],
      "wordCount": 72,
      "subsections": [
        {
          "id": "purpose-of-pomxml",
          "heading": "Purpose of pom.xml",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Defines project metadata and build configuration",
                "Declares dependencies required for compilation and testing",
                "Specifies plugins used during the build lifecycle",
                "Supports profiles for environment-specific builds"
              ]
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Project Object Model (POM)/Project%20Object%20Model%20(POM)/image.png",
              "alt": "image.png",
              "originalPath": "Project%20Object%20Model%20(POM)/image.png"
            }
          ],
          "wordCount": 25,
          "subsections": []
        }
      ]
    },
    {
      "id": "main-sections-of-pomxml",
      "heading": "Main Sections of pom.xml",
      "level": 2,
      "content": [
        {
          "type": "table",
          "headers": [
            "Section",
            "Description"
          ],
          "rows": [
            [
              "Project Information",
              "✅ Mandatory — uniquely identifies the project using groupId, artifactId, version, packaging."
            ],
            [
              "Dependencies",
              "⚙️ Optional — defines external libraries/artifacts (JARs) needed."
            ],
            [
              "Build Plugins",
              "🧩 Optional — declares plugins to customize and extend build steps."
            ],
            [
              "Build Profiles",
              "🛠️ Optional — allows environment-specific configuration (dev, test, prod). (Covered separately)"
            ],
            [
              "Properties",
              "🔢 Optional — defines reusable, centralized key-value pairs."
            ]
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Project Object Model (POM)/Project%20Object%20Model%20(POM)/image%201.png",
          "alt": "image.png",
          "originalPath": "Project%20Object%20Model%20(POM)/image%201.png"
        }
      ],
      "wordCount": 60,
      "subsections": []
    },
    {
      "id": "project-information-maven-coordinates",
      "heading": "Project Information: Maven Coordinates",
      "level": 2,
      "content": [
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Project Object Model (POM)/Project%20Object%20Model%20(POM)/image%202.png",
          "alt": "image.png",
          "originalPath": "Project%20Object%20Model%20(POM)/image%202.png"
        },
        {
          "type": "paragraph",
          "text": "These values uniquely identify a Maven project in the repository."
        },
        {
          "type": "table",
          "headers": [
            "Element",
            "Description"
          ],
          "rows": [
            [
              "groupId",
              "Typically the reverse domain name of the organization.  Examples: com.infosys.demos, org.apache."
            ],
            [
              "artifactId",
              "Name of the project or module.  Example: infycart."
            ],
            [
              "version",
              "Current version of the project."
            ]
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Use SNAPSHOT for active dev (e.g., 0.0.1-SNAPSHOT).",
            "Use RELEASE for stable versions. |\n| packaging | Type of final build output. Common values: jar, war, ear. |"
          ]
        },
        {
          "type": "blockquote",
          "text": "✅ Default in Infycart: jar, since it's a standalone Java project."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Project Object Model (POM)/Project%20Object%20Model%20(POM)/image%203.png",
          "alt": "image.png",
          "originalPath": "Project%20Object%20Model%20(POM)/image%203.png"
        }
      ],
      "wordCount": 77,
      "subsections": []
    },
    {
      "id": "dependencies-section",
      "heading": "Dependencies Section",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Used to declare external libraries required by the project."
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "xml",
          "code": "<dependencies>\n  <dependency>\n    <groupId>junit</groupId>\n    <artifactId>junit</artifactId>\n    <version>3.8.1</version>\n    <scope>test</scope>\n  </dependency>\n</dependencies>",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Dependencies are automatically downloaded from Maven repositories.",
            "Infycart's default project includes JUnit 3.8.1 for testing."
          ]
        }
      ],
      "wordCount": 25,
      "subsections": []
    },
    {
      "id": "build-plugin-section-optional",
      "heading": "Build Plugin Section (Optional)",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Used to customize the Maven build lifecycle by specifying plugins."
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "xml",
          "code": "<build>\n  <plugins>\n    <plugin>\n      <groupId>org.apache.maven.plugins</groupId>\n      <artifactId>maven-compiler-plugin</artifactId>\n      <version>2.1</version>\n      <configuration>\n        <source>${maven.compiler.release}</source>\n        <target>${maven.compiler.release}</target>\n      </configuration>\n    </plugin>\n  </plugins>\n</build>",
          "runnable": false
        }
      ],
      "wordCount": 11,
      "subsections": []
    },
    {
      "id": "properties-in-pomxml",
      "heading": "Properties in pom.xml",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Act as value placeholders to avoid hardcoding.",
            "Accessed using ${propertyName} syntax."
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Project Object Model (POM)/Project%20Object%20Model%20(POM)/image%204.png",
          "alt": "image.png",
          "originalPath": "Project%20Object%20Model%20(POM)/image%204.png"
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "xml",
          "code": "<properties>\n  <maven.compiler.release>11</maven.compiler.release>\n</properties>",
          "runnable": false
        }
      ],
      "wordCount": 12,
      "subsections": [
        {
          "id": "common-maven-properties",
          "heading": "Common Maven Properties",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Property",
                "Description"
              ],
              "rows": [
                [
                  "${project.basedir}",
                  "Refers to the root directory of the project (where pom.xml is)."
                ],
                [
                  "${project.build.directory}",
                  "Points to the target/ directory where build outputs are stored."
                ],
                [
                  "${project.build.sourceEncoding}",
                  "Specifies character encoding (e.g., UTF-8, ASCII)."
                ]
              ]
            }
          ],
          "wordCount": 32,
          "subsections": []
        }
      ]
    },
