{
  "id": "what-is-gradle-installing-gradle-windows",
  "slug": "installing-gradle-windows",
  "title": "Installing Gradle (Windows)",
  "category": "Build Tools",
  "sections": [
    {
      "id": "high-performance",
      "heading": "High Performance",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle improves build speed by:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Reusing outputs from previous builds",
            "Executing tasks in parallel",
            "Running only tasks whose inputs have changed"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "paragraph",
          "text": "If only one Java file changes, Gradle recompiles only the affected classes instead of rebuilding the entire project."
        }
      ],
      "wordCount": 40,
      "subsections": []
    },
    {
      "id": "supports-ant-tasks",
      "heading": "Supports Ant Tasks",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Gradle provides native support for Apache Ant",
            "Existing Ant build files can be imported and reused"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "groovy",
          "code": "ant.importBuild 'build.xml'",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "This allows teams to migrate gradually from Ant to Gradle without rewriting everything."
        }
      ],
      "wordCount": 30,
      "subsections": []
    },
    {
      "id": "supports-maven-repositories",
      "heading": "Supports Maven Repositories",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle uses Maven repositories to publish and resolve dependencies:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Maven Central",
            "Nexus",
            "Artifactory",
            "Custom internal repositories"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "code",
          "language": "groovy",
          "code": "repositories {\n    mavenCentral()\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "This means existing Maven infrastructure can still be used."
        }
      ],
      "wordCount": 26,
      "subsections": []
    },
    {
      "id": "uses-groovy-based-dsl-instead-of-xml",
      "heading": "Uses Groovy-Based DSL (Instead of XML)",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Gradle replaces verbose XML with Groovy-based Domain Specific Language",
            "Build scripts are readable, concise, and programmable"
          ]
        },
        {
          "type": "paragraph",
          "text": "Maven (XML):"
        },
        {
          "type": "code",
          "language": "xml",
          "code": "<dependency>\n  <groupId>org.springframework.boot</groupId>\n  <artifactId>spring-boot-starter-web</artifactId>\n</dependency>",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Gradle (Groovy DSL):"
        },
        {
          "type": "code",
          "language": "groovy",
          "code": "implementation 'org.springframework.boot:spring-boot-starter-web'",
          "runnable": false
        }
      ],
      "wordCount": 21,
      "subsections": []
    },
    {
      "id": "uses-dag-directed-acyclic-graph",
      "heading": "Uses DAG (Directed Acyclic Graph)",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Gradle models the build as a DAG",
            "Tasks are executed only after their dependencies are satisfied"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "paragraph",
          "text": "test → depends on → compileJava → depends on → processResources"
        },
        {
          "type": "paragraph",
          "text": "Gradle determines the optimal execution order automatically."
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "build-cache",
      "heading": "Build Cache",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Gradle stores outputs of tasks in a build cache",
            "Cached outputs are reused across builds and even across machines"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "paragraph",
          "text": "If another developer already compiled the same version of code, Gradle can reuse that output instead of recompiling."
        }
      ],
      "wordCount": 38,
      "subsections": []
    },
    {
      "id": "incremental-build",
      "heading": "Incremental Build",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle executes only required tasks by detecting changes since the last build."
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "If no change → task is skipped",
            "If change detected → task is re-executed"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example:"
        },
        {
          "type": "paragraph",
          "text": "Changing a README file will not trigger Java compilation."
        }
      ],
      "wordCount": 36,
      "subsections": []
    },
    {
      "id": "compile-avoidance",
      "heading": "Compile Avoidance",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle avoids unnecessary recompilation."
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "If class X depends on class Y",
            "And changes in Y do not affect X’s public API → X is not recompiled"
          ]
        },
        {
          "type": "paragraph",
          "text": "Result:"
        },
        {
          "type": "blockquote",
          "text": "Significantly faster builds for large projects"
        },
        {
          "type": "paragraph",
          "text": "Gradle is supported by all major IDEs:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "IntelliJ IDEA",
            "Eclipse (Buildship plugin)",
            "Visual Studio Code",
            "Android Studio"
          ]
        },
        {
          "type": "paragraph",
          "text": "These IDEs provide:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Auto-import of Gradle projects",
            "Task execution",
            "Dependency visualization"
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/What is Gradle/What%20is%20Gradle/image.png",
          "alt": "image.png",
          "originalPath": "What%20is%20Gradle/image.png"
        },
        {
          "type": "paragraph",
          "text": "Many large organizations have adopted Gradle, including:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Netflix",
            "LinkedIn",
            "Google (Android builds)",
            "Amazon",
            "Adobe",
            "Airbnb"
          ]
        },
        {
          "type": "paragraph",
          "text": "Gradle is widely used in enterprise-scale and high-performance builds."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/What is Gradle/What%20is%20Gradle/image%201.png",
          "alt": "image.png",
          "originalPath": "What%20is%20Gradle/image%201.png"
        },
        {
          "type": "paragraph",
          "text": "Gradle has two fundamental concepts:"
        }
      ],
      "wordCount": 90,
      "subsections": [
        {
          "id": "project",
          "heading": "Project",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A Project represents:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Something you build (e.g., JAR, WAR)",
                "Or something you do (e.g., deploy to production)"
              ]
            },
            {
              "type": "paragraph",
              "text": "A project:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Contains one or more tasks",
                "Can be part of a multi-project build"
              ]
            },
            {
              "type": "paragraph",
              "text": "Example:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "product-service",
                "order-service",
                "notification-service"
              ]
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/What is Gradle/What%20is%20Gradle/12eadb02-d21b-4d89-80cb-fede17c285d0.png",
              "alt": "image.png",
              "originalPath": "What%20is%20Gradle/12eadb02-d21b-4d89-80cb-fede17c285d0.png"
            }
          ],
          "wordCount": 35,
          "subsections": []
        },
        {
          "id": "task",
          "heading": "Task",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "A Task is an atomic unit of work in a build."
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Compile source code",
                "Run unit tests",
                "Package a JAR",
                "Deploy an application"
              ]
            },
            {
              "type": "paragraph",
              "text": "Example task:"
            },
            {
              "type": "code",
              "language": "groovy",
              "code": "task hello {\n    doLast {\n        println 'Hello Gradle!'\n    }\n}",
              "runnable": false
            }
          ],
          "wordCount": 25,
          "subsections": []
        },
        {
          "id": "relationship-between-project-and-task",
          "heading": "Relationship Between Project and Task",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Every Gradle build has one or more projects",
                "Each project has one or more tasks",
                "Tasks form a DAG defining execution order"
              ]
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/What is Gradle/What%20is%20Gradle/image%202.png",
              "alt": "image.png",
              "originalPath": "What%20is%20Gradle/image%202.png"
            },
            {
              "type": "table",
              "headers": [
                "File",
                "Purpose"
              ],
              "rows": [
                [
                  "build.gradle",
                  "Main build script"
                ],
                [
                  "settings.gradle",
                  "Defines multi-project builds"
                ],
                [
                  "gradle.properties",
                  "Configuration properties"
                ],
                [
                  "gradlew",
                  "Gradle Wrapper (Linux/Mac)"
                ],
                [
                  "gradlew.bat",
                  "Gradle Wrapper (Windows)"
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Gradle Wrapper ensures consistent Gradle versions across teams."
            }
          ],
          "wordCount": 51,
          "subsections": []
        },
        {
          "id": "step-1-download-gradle",
          "heading": "Step 1: Download Gradle",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Download the latest Gradle distribution from www.gradle.org",
                "File format: .zip"
              ]
            }
          ],
          "wordCount": 10,
          "subsections": []
        },
        {
          "id": "step-2-create-installation-directory",
          "heading": "Step 2: Create Installation Directory",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Example: D:\\Gradle"
              ]
            }
          ],
          "wordCount": 2,
          "subsections": []
        },
        {
          "id": "step-3-extract-gradle",
          "heading": "Step 3: Extract Gradle",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Unzip the downloaded file into: D:\\Gradle\\gradle-x.y.z"
              ]
            }
          ],
          "wordCount": 6,
          "subsections": []
        },
        {
          "id": "step-4-configure-environment-variables",
          "heading": "Step 4: Configure Environment Variables",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Open Advanced System Settings",
                "Click Environment Variables",
                "Under System Variables, select Path",
                "Click Edit",
                "Add: D:\\Gradle\\gradle-x.y.z\\bin",
                "Click OK to save"
              ]
            }
          ],
          "wordCount": 20,
          "subsections": []
        },
        {
          "id": "step-5-verify-installation",
          "heading": "Step 5: Verify Installation",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Open Command Prompt and run:"
            },
            {
              "type": "code",
              "language": "bash",
              "code": "gradle -v",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "If Gradle version details appear, installation is successful ✅"
            }
          ],
          "wordCount": 14,
          "subsections": []
        }
      ]
    }
