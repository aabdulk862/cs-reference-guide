{
  "id": "gradle-for-java-gradle-for-java",
  "slug": "gradle-for-java",
  "title": "Gradle for Java",
  "category": "Build Tools",
  "sections": [
    {
      "id": "creating-a-java-project-using-gradle-cli",
      "heading": "Creating a Java Project Using Gradle CLI",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle allows you to create a Java project that follows Gradle’s conventions using the Gradle CLI."
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/Gradle for Java/Gradle%20for%20Java/image.png",
          "alt": "image.png",
          "originalPath": "Gradle%20for%20Java/image.png"
        },
        {
          "type": "paragraph",
          "text": "Main Steps:"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Create a project folder",
            "Run the init task",
            "Run the application"
          ]
        }
      ],
      "wordCount": 29,
      "subsections": []
    },
    {
      "id": "step-1-create-project-folder",
      "heading": "Step 1: Create Project Folder",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Navigate to the folder where Gradle is installed. Example: D:\\Gradle",
            "Create a folder for your project: D:\\Gradle\\firstProject",
            "Open Command Prompt and navigate to the folder: D:\\Gradle\\firstProject>"
          ]
        }
      ],
      "wordCount": 26,
      "subsections": []
    },
    {
      "id": "step-2-run-the-init-task",
      "heading": "Step 2: Run the init Task",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Run the Gradle init task to generate a new project structure:"
        },
        {
          "type": "code",
          "language": "bash",
          "code": "gradle init",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Prompts:"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Select type of project: 1: basic\n2: application\n3: library\n4: Gradle plugin → Choose 2: application",
            "Select implementation language: 1: C++\n2: Groovy\n3: Java\n4: Kotlin\n5: Scala\n6: Swift → Choose 3: Java",
            "Select build script DSL: 1: Groovy\n2: Kotlin → Choose 1: Groovy (default)",
            "Select test framework: (Press Enter for default, e.g., JUnit 4)",
            "Project name & source package: (Press Enter for defaults)"
          ]
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "BUILD SUCCESSFUL\n2 actionable tasks: 2 executed",
          "runnable": false
        }
      ],
      "wordCount": 81,
      "subsections": []
    },
    {
      "id": "step-3-run-the-application",
      "heading": "Step 3: Run the Application",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle’s application plugin allows you to run the Java application directly:"
        },
        {
          "type": "code",
          "language": "bash",
          "code": "D:\\Gradle\\firstProject>gradlew run\n",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "This executes the main method defined in the mainClass property."
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/Gradle for Java/Gradle%20for%20Java/image%201.png",
          "alt": "image.png",
          "originalPath": "Gradle%20for%20Java/image%201.png"
        }
      ],
      "wordCount": 22,
      "subsections": []
    },
    {
      "id": "project-structure-generated-by-gradle",
      "heading": "Project Structure Generated by Gradle",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "key-folders",
          "heading": "Key Folders:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "gradle/ – Wrapper files",
                "app/ – Subproject containing code ",
                "build/ – Output folder created after gradlew build "
              ]
            }
          ],
          "wordCount": 17,
          "subsections": []
        },
        {
          "id": "important-files",
          "heading": "Important Files:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": true,
              "items": [
                "gradle-wrapper.properties – Defines Gradle distribution:"
              ]
            },
            {
              "type": "code",
              "language": "",
              "code": "distributionBase=GRADLE_USER_HOME\ndistributionPath=wrapper/dists\ndistributionUrl=https://services.gradle.org/distributions/gradle-7.0.2-bin.zip\nzipStoreBase=GRADLE_USER_HOME\nzipStorePath=wrapper/dists",
              "runnable": false
            },
            {
              "type": "list",
              "ordered": true,
              "items": [
                "gradlew / gradlew.bat – Shell and Windows scripts for building projects"
              ]
            },
            {
              "type": "paragraph",
              "text": "Advantages of Gradle Wrapper:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "No need to pre-install Gradle",
                "Ensures consistent Gradle version across teams",
                "Easily upgrade Gradle and share via version control"
              ]
            }
          ],
          "wordCount": 39,
          "subsections": []
        }
      ]
    },
    {
      "id": "settingsgradle",
      "heading": "settings.gradle",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Specifies the root project name and subprojects:"
        },
        {
          "type": "code",
          "language": "groovy",
          "code": "rootProject.name = 'firstProject'\ninclude('app')",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "rootProject.name → Overrides default project name",
            "include('app') → Includes the app subproject"
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/Gradle for Java/Gradle%20for%20Java/image%202.png",
          "alt": "image.png",
          "originalPath": "Gradle%20for%20Java/image%202.png"
        }
      ],
      "wordCount": 19,
      "subsections": []
    },
    {
      "id": "buildgradle-app-project",
      "heading": "build.gradle (App Project)",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Generated build.gradle defines the Java project configuration:"
        },
        {
          "type": "code",
          "language": "groovy",
          "code": "plugins {\n    id 'application'\n}\nrepositories {\n    mavenCentral()\n}\ndependencies {\n    testImplementation 'junit:junit:4.13.1'\n    implementation 'com.google.guava:guava:30.0-jre'\n}\napplication {\n    mainClass = 'firstProject.App'\n}",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Highlights:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Plugins → Apply application plugin for CLI apps",
            "Repositories → Use Maven Central",
            "Dependencies → JUnit for testing, Guava for utilities",
            "Application → Specifies mainClass"
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/Gradle for Java/Gradle%20for%20Java/image%203.png",
          "alt": "image.png",
          "originalPath": "Gradle%20for%20Java/image%203.png"
        }
      ],
      "wordCount": 33,
      "subsections": []
    },
    {
      "id": "appjava",
      "heading": "App.java",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Located at app/src/main/java/firstProject/App.java:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "package firstProject;\n\npublic class App {\n    public String getGreeting() {\n        return \"Hello World!\";\n    }\n    public static void main(String[] args) {\n        System.out.println(new App().getGreeting());\n    }\n}",
          "runnable": false
        }
      ],
      "wordCount": 3,
      "subsections": []
    },
    {
      "id": "apptestjava",
      "heading": "AppTest.java",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Located at app/src/test/java/firstProject/AppTest.java:"
        },
        {
          "type": "code",
          "language": "java",
          "code": "package firstProject;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\n\npublic class AppTest {\n    @Test public void testAppHasAGreeting() {\n        App classUnderTest = new App();\n        assertNotNull(\"app should have a greeting\", classUnderTest.getGreeting());\n    }\n}\n",
          "runnable": false
        }
      ],
      "wordCount": 3,
      "subsections": []
    },
    {
      "id": "building-the-project",
      "heading": "Building the Project",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Run the build command:"
        },
        {
          "type": "code",
          "language": "bash",
          "code": "D:\\Gradle\\firstProject>gradlew build",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "bash",
          "code": "BUILD SUCCESSFUL in 5s\n7 actionable tasks: 6 executed, 1 up-to-date\nD:\\Gradle\\firstProject>",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Build Output Folders:"
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "reports/ → Test reports",
            "libs/ → Application JAR",
            "distributions/ → Packaged app (.zip, .tar)"
          ]
        },
        {
          "type": "image",
          "src": "/Users/luffy/Desktop/Computer Science/Infosys/Gradle/Gradle for Java/Gradle%20for%20Java/image%204.png",
          "alt": "image.png",
          "originalPath": "Gradle%20for%20Java/image%204.png"
        },
        {
          "type": "paragraph",
          "text": "Bundled Application: Includes all dependencies and scripts to run with a single command."
        }
      ],
      "wordCount": 35,
      "subsections": []
    },
    {
      "id": "working-with-custom-tasks",
      "heading": "Working with Custom Tasks",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Gradle tasks are atomic units of work."
        }
      ],
      "wordCount": 7,
      "subsections": []
    },
    {
      "id": "simple-task-example",
      "heading": "Simple Task Example:",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "groovy",
          "code": "task printTask {\n    println 'The project is configured'\n}\n\n// Run the task:\ngradle -q printTask",
          "runnable": false
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "q → Quiet mode (suppresses extra logs)"
          ]
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "The project is configured",
          "runnable": false
        }
      ],
      "wordCount": 8,
      "subsections": []
    },
    {
      "id": "using-tasksregister-and-dolast",
      "heading": "Using tasks.register() and doLast()",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "groovy",
          "code": "tasks.register('printExecution') {\n    doLast {\n        println \"During Execution\"\n    }\n}\n\n// Run the task:\n\tgradle -q printExecution",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "During Execution",
          "runnable": false
        }
      ],
      "wordCount": 1,
      "subsections": []
    },
    {
      "id": "using-variables-and-functions",
      "heading": "Using Variables and Functions",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "groovy",
          "code": "tasks.register('printUpper') {\n    doLast {\n        String nameString = 'Sam'\n        println \"Original: $nameString\"\n        println \"Upper case: ${nameString.toUpperCase()}\"\n    }\n}\n\n// Run the task:\n\tgradle -q printUpper",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "Original: Sam\nUpper case: SAM",
          "runnable": false
        }
      ],
      "wordCount": 1,
      "subsections": []
    },
    {
      "id": "task-dependencies",
      "heading": "Task Dependencies",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "groovy",
          "code": "tasks.register('deployStage1') {\n    doLast { println \"deploy stage 1 going on\" }\n}\n\ntasks.register('deployStage2') {\n    dependsOn tasks.deployStage1\n    doLast { println \"deploy stage 2 going on\" }\n}\n\n// Run the task:\ngradle -q deployStage2",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Output:"
        },
        {
          "type": "code",
          "language": "",
          "code": "deploy stage 1 going on\ndeploy stage 2 going on",
          "runnable": false
        }
      ],
      "wordCount": 1,
      "subsections": []
    },
