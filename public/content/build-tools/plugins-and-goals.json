          "id": "tomcat7-maven-plugin",
          "heading": "tomcat7-maven-plugin",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "Runs WAR project using embedded Tomcat."
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Apache Maven/Plugins and Goals/Plugins%20and%20Goals/image%2016.png",
              "alt": "image.png",
              "originalPath": "Plugins%20and%20Goals/image%2016.png"
            },
            {
              "type": "paragraph",
              "text": "Plugin Configuration:"
            },
            {
              "type": "code",
              "language": "xml",
              "code": "<plugin>\n  <groupId>org.apache.tomcat.maven</groupId>\n  <artifactId>tomcat7-maven-plugin</artifactId>\n  <version>2.2</version>\n  <configuration>\n    <port>9090</port>\n    <path>/</path>\n  </configuration>\n</plugin>",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Command:"
            },
            {
              "type": "code",
              "language": "bash",
              "code": "mvn clean package tomcat7:run",
              "runnable": false
            },
            {
              "type": "blockquote",
              "text": "WAR file generated: target/infycart-webapp.war"
            },
