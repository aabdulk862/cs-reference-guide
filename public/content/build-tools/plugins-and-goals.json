              "type": "code",
              "language": "xml",
              "code": "<plugin>\n  <groupId>org.apache.maven.plugins</groupId>\n  <artifactId>maven-compiler-plugin</artifactId>\n  <version>2.1</version>\n  <configuration>\n    <source>1.8</source>\n    <target>1.8</target>\n  </configuration>\n</plugin>",
              "runnable": false
