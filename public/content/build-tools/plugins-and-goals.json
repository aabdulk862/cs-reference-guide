              "originalPath": "Plugins%20and%20Goals/image%2013.png"
            },
            {
              "type": "paragraph",
              "text": "Plugin Configuration:"
            },
            {
              "type": "code",
              "language": "xml",
              "code": "<plugin>\n  <artifactId>maven-javadoc-plugin</artifactId>\n  <executions>\n    <execution>\n      <id>attach-javadocs</id>\n      <goals>\n        <goal>jar</goal>\n      </goals>\n    </execution>\n  </executions>\n</plugin>",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Command:"
            },
            {
              "type": "code",
              "language": "bash",
              "code": "mvn javadoc:javadoc",
              "runnable": false
            },
