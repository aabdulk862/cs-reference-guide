  "title": "Plugins and Goals",
  "category": "Build Tools",
  "sections": [
    {
      "id": "maven-build-lifecycle",
      "heading": "Maven Build Lifecycle",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Definition: Maven build lifecycle is a structured sequence of phases that define the process of building and distributing a Java-based project."
        }
      ],
      "wordCount": 21,
      "subsections": [
        {
          "id": "built-in-lifecycles",
          "heading": "Built-in Lifecycles:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "clean – Cleans the previous build.",
                "default – Main lifecycle for compiling, testing, packaging, and deploying.",
                "site – Generates documentation and reports."
              ]
            },
            {
              "type": "blockquote",
              "text": "🔹 Triggering a later phase automatically triggers all prior phases."
            }
          ],
          "wordCount": 32,
          "subsections": []
        },
        {
          "id": "clean-lifecycle-phases",
          "heading": "Clean Lifecycle Phases",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Phase",
                "Description"
              ],
              "rows": [
                [
                  "pre-clean",
                  "Preparation steps before actual cleaning"
                ],
                [
                  "clean",
                  "Deletes target directory and build outputs"
                ],
                [
                  "post-clean",
                  "Finalization tasks after cleaning"
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Command:"
            },
            {
              "type": "code",
              "language": "bash",
              "code": "mvn clean",
              "runnable": false
            },
            {
              "type": "blockquote",
              "text": "Internally uses maven-clean-plugin (v2.5)"
            }
          ],
          "wordCount": 25,
          "subsections": []
        },
        {
          "id": "default-lifecycle-full-build-process",
          "heading": "Default Lifecycle – Full Build Process",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Phase",
                "Description"
              ],
              "rows": [
                [
                  "validate",
                  "Verifies project structure and pom.xml"
                ],
                [
                  "compile",
                  "Compiles source files into .class files"
                ],
                [
                  "test",
                  "Executes unit tests using JUnit/TestNG"
                ],
                [
                  "package",
                  "Bundles compiled code into JAR/WAR/EAR"
                ],
                [
                  "verify",
                  "Checks if packaged code meets quality criteria"
                ],
                [
                  "install",
                  "Installs artifact to local Maven repository"
                ],
                [
                  "deploy",
                  "Uploads artifact to remote Maven repository"
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Command:"
            },
            {
              "type": "code",
              "language": "bash",
              "code": "mvn package",
              "runnable": false
            },
            {
              "type": "blockquote",
              "text": "Executes all preceding phases from validate to package."
            }
          ],
          "wordCount": 58,
          "subsections": []
        }
      ]
    },
    {
      "id": "what-are-plugins-and-goals",
      "heading": "What Are Plugins and Goals?",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Plugin: A Maven extension to perform specific build tasks.",
            "Goal: A specific action provided by a plugin."
          ]
        }
      ],
      "wordCount": 17,
      "subsections": [
        {
          "id": "plugin-categories",
          "heading": "Plugin Categories:",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Build Plugins: Used in <build> section.",
                "Reporting Plugins: Used in <reporting> section."
              ]
            }
          ],
          "wordCount": 12,
          "subsections": []
        }
      ]
    },
