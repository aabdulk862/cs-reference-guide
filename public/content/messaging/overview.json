          "id": "what-is-apache-kafka",
          "heading": "What is Apache Kafka?",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Open-source, distributed messaging system.",
                "Built to handle real-time data streaming.",
                "Developed at LinkedIn using Scala.",
                "Now a top-level Apache project."
              ]
            },
