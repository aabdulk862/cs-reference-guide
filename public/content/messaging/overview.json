        {
          "id": "2-apache-kafka-architecture-components",
          "heading": "2. Apache Kafka Architecture & Components",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Component",
                "Description"
              ],
              "rows": [
                [
                  "Producer",
                  "Sends messages to Kafka topics."
                ],
                [
                  "Consumer",
                  "Subscribes to and reads messages from topics."
                ],
                [
                  "Broker",
                  "Kafka server that stores and serves data."
                ],
                [
                  "Topic",
                  "Logical channel where messages are published."
                ],
                [
                  "Partition",
                  "Split of a topic to allow parallelism."
                ],
                [
                  "Offset",
                  "Position ID of a message in a partition."
                ],
                [
                  "Leader/Follower",
                  "Partitions have 1 leader and N followers for replication."
                ],
                [
                  "Zookeeper",
                  "Manages cluster state, broker metadata, and leader elections."
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Kafka is distributed, fault-tolerant, and scalable."
            }
          ],
          "wordCount": 73,
          "subsections": []
        },
        {
          "id": "3-role-of-zookeeper-in-kafka",
          "heading": "3. Role of Zookeeper in Kafka",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Coordinates and maintains Kafka cluster metadata.",
                "Handles broker registration and leader election.",
                "Ensures high availability by monitoring broker health.",
                "Required for Kafka pre-v2.8 (later versions can use KRaft as alternative)."
              ]
            }
          ],
          "wordCount": 30,
          "subsections": []
        },
