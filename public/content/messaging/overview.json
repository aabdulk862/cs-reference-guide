        {
          "id": "real-time-data",
          "heading": "Real-Time Data",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: Data that is collected and processed immediately after an event or transaction occurs.",
                "Example: When a user clicks on a product in an online store, the data is captured instantly."
              ]
            }
          ],
          "wordCount": 31,
          "subsections": []
        },
        {
          "id": "message",
          "heading": "Message",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: A log/event/record generated when an action occurs in a system.",
                "Details: A message may contain user ID, action (like \"clicked product\"), timestamp, and product info.",
                "Example: {\"user\":\"john123\", \"action\":\"click\", \"product\":\"iPhone15\", \"timestamp\":\"2025-06-20T14:00Z\"}"
              ]
            }
          ],
          "wordCount": 31,
          "subsections": []
        },
        {
          "id": "clickstream-data",
          "heading": "Clickstream Data",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Definition: Sequence of actions performed by users on a website.",
                "Example: Product views, clicks, searches, time spent."
              ]
            }
          ],
          "wordCount": 17,
          "subsections": []
        }
      ]
    },
