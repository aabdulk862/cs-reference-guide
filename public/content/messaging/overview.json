          "id": "components",
          "heading": "Components",
          "level": 3,
          "content": [
            {
              "type": "table",
              "headers": [
                "Component",
                "Role"
              ],
              "rows": [
                [
                  "Producer",
                  "Sends messages to Kafka topics"
                ],
                [
                  "Consumer",
                  "Reads messages from topics"
                ],
                [
                  "Broker",
                  "Kafka server storing partitions of topics"
                ],
                [
                  "Zookeeper",
                  "Manages metadata and broker coordination"
                ],
                [
                  "Topic",
                  "Logical stream of messages"
                ],
                [
                  "Partition",
                  "Subset of a topic (parallelism unit)"
                ],
                [
                  "Offset",
                  "Unique ID of each message in a partition"
                ],
                [
                  "Leader",
                  "Broker handling writes/reads for a partition"
                ],
                [
                  "Follower",
                  "Replicated copy of partition for failover"
                ],
                [
                  "ISR (In-Sync Replica)",
                  "Follower fully synced with leader"
                ]
              ]
            }
          ],
