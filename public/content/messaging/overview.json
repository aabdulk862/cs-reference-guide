    {
      "id": "kafka-installation-steps",
      "heading": "Kafka Installation Steps",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "prerequisites",
          "heading": "Prerequisites",
          "level": 3,
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "JDK 1.7+",
                "Zookeeper (or bundled with Kafka)",
                "Apache Kafka (latest version)",
                "Linux terminal access (e.g., Putty)"
              ]
            }
          ],
          "wordCount": 16,
          "subsections": []
        },
        {
          "id": "1-zookeeper-installation",
          "heading": "1. Zookeeper Installation",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "tar -xvf zookeeper.tar\nvi ~/.bashrc\nexport ZOOKEEPER_HOME=/home/admin/Installations/Zookeeper/zookeeper-3.3.5\nexport PATH=${PATH}:${ZOOKEEPER_HOME}/bin\nzkServer.sh start",
              "runnable": false
            },
            {
              "type": "image",
              "src": "/Users/luffy/Desktop/Computer Science/Infosys/Introduction to Apache Kafka/Overview/Overview/image%209.png",
              "alt": "image.png",
              "originalPath": "Overview/image%209.png"
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "2-kafka-installation",
          "heading": "2. Kafka Installation",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "tar -xvf kafka.tar",
              "runnable": false
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "bin/ → Scripts",
                "config/ → Configuration files "
              ]
            }
          ],
          "wordCount": 7,
          "subsections": []
        },
        {
          "id": "3-start-services",
          "heading": "3. Start Services",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "# Zookeeper (if not started already)\nbin/zookeeper-server-start.sh config/zookeeper.properties\n\n# Kafka broker\nbin/kafka-server-start.sh config/server.properties",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "4-create-kafka-topic",
          "heading": "4. Create Kafka Topic",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "bin/kafka-topics.sh --create --zookeeper localhost:2181 --replication-factor 1 --partitions 1 --topic NewTopic",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "5-start-producer",
          "heading": "5. Start Producer",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "bin/kafka-console-producer.sh --broker-list localhost:9092 --topic NewTopic",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "Type messages and press Enter to publish."
            }
          ],
          "wordCount": 7,
          "subsections": []
        },
        {
          "id": "6-start-consumer",
          "heading": "6. Start Consumer",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "bash",
              "code": "bin/kafka-console-consumer.sh --zookeeper localhost:2181 --topic NewTopic --from-beginning",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
      ]
    },
    {
      "id": "multiple-broker-setup-on-single-server",
