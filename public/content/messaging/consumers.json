    {
      "id": "code-walkthrough-java-consumer-app",
      "heading": "Code Walkthrough – Java Consumer App",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": [
        {
          "id": "package",
          "heading": "Package:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "java",
              "code": "package com.project.kafka.ConsumerPackage;",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "key-steps-in-code",
          "heading": "Key Steps in Code:",
          "level": 3,
          "content": [
            {
              "type": "paragraph",
              "text": "(i) Define consumer configuration:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "consumerProps.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, \"localhost:9092\");\nconsumerProps.put(ConsumerConfig.GROUP_ID_CONFIG, \"test-consumer-group\");\nconsumerProps.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());\nconsumerProps.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "(ii) Create and subscribe to topic:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "KafkaConsumer<String, String> consumer = new KafkaConsumer<>(consumerProps);\nconsumer.subscribe(Arrays.asList(\"CleansedYouBuyyClickStreamData\"));",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "(iii) Poll and process messages:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "ConsumerRecords<String, String> records = consumer.poll(30000);\nfor (ConsumerRecord<String, String> record : records) {\n    System.out.printf(\"Key: %s, Value: %s, Partition: %d, Offset: %d\\n\",\n        record.key(), record.value(), record.partition(), record.offset());\n}\nconsumer.commitAsync();",
              "runnable": false
            },
            {
              "type": "paragraph",
              "text": "(iv) Close consumer after polling:"
            },
            {
              "type": "code",
              "language": "java",
              "code": "consumer.close();",
              "runnable": false
            }
          ],
          "wordCount": 20,
          "subsections": []
        }
      ]
