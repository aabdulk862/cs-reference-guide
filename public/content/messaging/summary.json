      "id": "minimal-config-for-kraft",
      "heading": "Minimal Config for KRaft",
      "level": 3,
      "content": [
        {
          "type": "code",
          "language": "",
          "code": "process.roles=broker,controller\nnode.id=1\ncontroller.quorum.voters=1@localhost:9093\nlisteners=PLAINTEXT://:9092,CONTROLLER://:9093\nlog.dirs=/tmp/kraft-logs",
          "runnable": false
        },
        {
          "type": "table",
          "headers": [
            "Aspect",
            "Description"
          ],
          "rows": [
            [
              "UUIDs",
              "Used for broker ID and cluster ID"
            ],
            [
              "Security",
              "TLS, SCRAM, OAuth support in Kafka directly"
            ],
            [
              "Metadata Replication",
              "Via Raft consensus"
            ],
            [
              "No External Access",
              "Metadata internal to Kafka; Zookeeper no longer needed"
            ]
          ]
        },
        {
          "type": "table",
          "headers": [
            "Feature",
            "Benefit"
          ],
          "rows": [
            [
              "No Zookeeper Latency",
              "Direct Kafka-native controller election"
            ],
            [
              "Metadata Scalability",
              "Faster topic/partition creation"
            ],
            [
              "Reduced Complexity",
              "Single binary, no ZK ops"
            ],
            [
              "Simplified Security",
              "One layer of security setup"
            ]
          ]
        },
        {
          "type": "blockquote",
          "text": "Kafka offers tools to migrate metadata from Zookeeper to KRaft"
