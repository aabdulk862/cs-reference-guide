{
  "id": "introduction-to-apache-kafka-windows-setup",
  "slug": "windows-setup",
  "title": "Windows Setup",
  "category": "Messaging",
  "sections": [
    {
      "id": "getting-started",
      "heading": "Getting Started",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "1-prerequisites",
      "heading": "1. Prerequisites",
      "level": 2,
      "content": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            "✅ Java JDK 8+",
            "✅ Apache Kafka (binary release)",
            "✅ 7-Zip or any unzip tool",
            "✅ Set JAVA_HOME environment variable (optional but recommended)"
          ]
        }
      ],
      "wordCount": 23,
      "subsections": []
    },
    {
      "id": "2-download-kafka",
      "heading": "2. Download Kafka",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Download from:"
        },
        {
          "type": "paragraph",
          "text": "📦 https://kafka.apache.org/downloads"
        },
        {
          "type": "paragraph",
          "text": "Choose a binary release (e.g., Scala 2.13 / Kafka 3.6.1)."
        }
      ],
      "wordCount": 14,
      "subsections": []
    },
    {
      "id": "3-extract-kafka",
      "heading": "3. Extract Kafka",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Unzip the downloaded Kafka ZIP file to a local folder, e.g.:"
        },
        {
          "type": "code",
          "language": "powershell",
          "code": "C:\\kafka\\",
          "runnable": false
        }
      ],
      "wordCount": 11,
      "subsections": []
    },
    {
      "id": "4-start-zookeeper",
      "heading": "4. Start Zookeeper",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Kafka needs Zookeeper (unless using KRaft mode)."
        },
        {
          "type": "paragraph",
          "text": "Open Command Prompt:"
        },
        {
          "type": "code",
          "language": "powershell",
          "code": "cd C:\\kafka\n.\\bin\\windows\\zookeeper-server-start.bat .\\config\\zookeeper.properties",
          "runnable": false
        }
      ],
      "wordCount": 10,
      "subsections": []
    },
    {
      "id": "5-start-kafka-broker",
      "heading": "5. Start Kafka Broker",
      "level": 2,
      "content": [
        {
          "type": "paragraph",
          "text": "Open another Command Prompt:"
        },
        {
          "type": "code",
          "language": "powershell",
          "code": "cd C:\\kafka\n.\\bin\\windows\\kafka-server-start.bat .\\config\\server.properties",
          "runnable": false
        }
      ],
      "wordCount": 4,
      "subsections": []
    },
    {
      "id": "basic-kafka-commands",
      "heading": "Basic Kafka Commands",
      "level": 2,
      "content": [],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "create-a-topic",
      "heading": "Create a topic",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "powershell",
          "code": ".\\bin\\windows\\kafka-topics.bat --create --topic test-topic --bootstrap-server localhost:9092 --partitions 3 --replication-factor 1",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "list-all-topics",
      "heading": "List all topics",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "powershell",
          "code": ".\\bin\\windows\\kafka-topics.bat --list --bootstrap-server localhost:9092\n",
          "runnable": false
        }
      ],
      "wordCount": 0,
      "subsections": []
    },
    {
      "id": "describe-a-topic",
      "heading": "Describe a topic",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "powershell",
          "code": ".\\bin\\windows\\kafka-topics.bat --describe --topic test-topic --bootstrap-server localhost:9092\n",
