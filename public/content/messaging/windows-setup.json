    },
    {
      "id": "produce-messages",
      "heading": "Produce messages",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "powershell",
          "code": ".\\bin\\windows\\kafka-console-producer.bat --topic test-topic --bootstrap-server localhost:9092\n",
          "runnable": false
        },
        {
          "type": "paragraph",
          "text": "Type messages line-by-line and press Enter."
        }
      ],
      "wordCount": 6,
      "subsections": []
    },
    {
      "id": "consume-messages",
      "heading": "Consume messages",
      "level": 2,
      "content": [
        {
          "type": "code",
          "language": "powershell",
          "code": ".\\bin\\windows\\kafka-console-consumer.bat --topic test-topic --from-beginning --bootstrap-server localhost:9092\n",
          "runnable": false
        }
      ],
      "wordCount": 0,
