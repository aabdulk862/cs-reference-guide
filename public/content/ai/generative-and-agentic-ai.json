            {
              "type": "code",
              "language": "python",
              "code": "from pathlib import Path\nfrom phi.agent.python import PythonAgent\nfrom phi.model.google import Gemini\nfrom phi.file.local.csv import CsvFile",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        },
        {
          "id": "create-agent-with-csv-access",
          "heading": "Create Agent with CSV Access:",
          "level": 3,
          "content": [
            {
              "type": "code",
              "language": "python",
              "code": "cwd = Path('./Codes/PhiData/').parent.resolve()\ntmp = cwd.joinpath(\"tmp\")\nif not tmp.exists():\n    tmp.mkdir(exist_ok=True, parents=True)\n\npython_agent = PythonAgent(\n   model=Gemini(id=\"gemini-1.5-pro\"),\n   base_dir=tmp,\n   files=[CsvFile(\n       path=\"https://phidata-public.s3.amazonaws.com/demo_data/IMDB-Movie-Data.csv\",\n       description=\"Contains information about movies from IMDB.\"\n   )],\n   markdown=True,\n   pip_install=True,\n   show_tool_calls=True,\n)\n\npython_agent.print_response(\"What is the average rating of movies?\")\npython_agent.print_response(\"Describe the numerical variables\")",
              "runnable": false
            }
          ],
          "wordCount": 0,
          "subsections": []
        }
