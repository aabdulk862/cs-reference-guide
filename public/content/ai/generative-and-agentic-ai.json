            {
              "type": "code",
              "language": "python",
              "code": "import getpass\nimport os\nfrom phi.agent import Agent, RunResponse\nfrom phi.model.google import Gemini",
              "runnable": false
            },
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Set API Key"
              ]
            },
            {
              "type": "code",
              "language": "python",
              "code": "def _set_env(var: str):\n    if not os.environ.get(var):\n        os.environ[var] = getpass.getpass(f\"{var}: \")\n_set_env(\"GOOGLE_API_KEY\")\n",
              "runnable": false
            },
            {
              "type": "list",
              "ordered": true,
              "items": [
                "Create and Run Agent"
              ]
            },
            {
              "type": "code",
              "language": "python",
              "code": "agent = Agent(model=Gemini(id=\"gemini-1.5-flash\"), markdown=True)\nrun = agent.run(\"Narrate me an Indian cricket story in 50 words.\")\nprint(run.content)",
              "runnable": false
            }
